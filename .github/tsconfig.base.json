// Sources are executed directly by Node.js using type stripping.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    // Avoid generating tsconfig.tsbuildinfo file, which isn't useful for our scenario
    "incremental": false
  }
}
