    "js-yaml": "catalog:",
    "marked": "catalog:",
    "markdown-table": "catalog:",
    "simple-git": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "catalog:",
    "@actions/github-script": "catalog:",
    "@eslint/js": "catalog:",
    "@octokit/core": "catalog:",
