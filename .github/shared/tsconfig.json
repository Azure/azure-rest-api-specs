{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "checkJs": true,
    "incremental": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["**/*.ts"],
  "exclude": ["coverage"]
}
