{
  "name": "@azure-tools/sdk-breaking-change-workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@azure-tools/spec-gen-sdk-runner": "workspace:*",
    "@azure-tools/specs-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  }
}
