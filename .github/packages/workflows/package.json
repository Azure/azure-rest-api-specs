{
  "name": "@azure-tools/github-workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "_comments": {
    "dependencies": "Lean runtime dependencies for fast github-script workflows. Workflows requiring heavy or cross-workspace dependencies belong in their own sibling package under .github/packages/."
  },
  "dependencies": {
    "@azure-tools/github-core": "workspace:*",
    "@azure-tools/specs-shared": "workspace:*",
    "@js-temporal/polyfill": "catalog:",
    "minimatch": "catalog:",
    "simple-git": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@actions/core": "catalog:",
    "@actions/github": "catalog:",
    "@octokit/core": "catalog:",
    "@octokit/endpoint": "catalog:",
    "@octokit/openapi-webhooks-types": "catalog:",
    "@octokit/plugin-paginate-rest": "catalog:",
    "@octokit/plugin-rest-endpoint-methods": "catalog:",
    "@octokit/request-error": "catalog:",
    "@octokit/rest": "catalog:",
    "@octokit/types": "catalog:",
    "@types/node": "catalog:",
    "@vitest/utils": "catalog:",
    "fflate": "catalog:",
    "marked": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "labels": "node ./cmd/labels.ts",
    "check": "pnpm test:ci && pnpm lint && pnpm format:check",
    "lint": "pnpm lint:oxlint && pnpm lint:tsc",
    "lint:oxlint": "oxlint .",
    "lint:tsc": "pnpm build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  }
}
