{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "checkJs": true,
    "incremental": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*.ts", "cmd/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["coverage"]
}
