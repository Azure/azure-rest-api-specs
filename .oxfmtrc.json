{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.tsp",
    "specification/**/*.json",
    ".github/**/coverage/**",
    ".github/**/fixtures/**",
    ".github/**/specification/**",
    ".github/**/*.lock.yml",
    // cspell:ignore agentics
    ".github/workflows/agentics-maintenance.yml",
    ".github/policies/**",
    ".github/workflows/post-apiview.yml",
    ".github/skills/azsdk-common-*/**",
    ".github/skills/evals/*/results/**",
    ".github/skills/evals/*/session-state/**",
    "eng/tools/**/coverage/**",
    "eng/tools/**/dist/**",
    "eng/tools/**/fixtures/**",
    "eng/tools/**/specification/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.json"
      ],
      "options": {
        "printWidth": 20
      }
    },
    {
      "files": [
        "**/*.ts"
      ],
      "options": {
        "printWidth": 100,
        "endOfLine": "lf"
      }
    },
    {
      "files": [
        ".github/**",
        "eng/tools/**"
      ],
      "options": {
        "printWidth": 100,
        "endOfLine": "lf"
      }
    }
  ]
}
