{
  "name": "@azure-tools/release-plan",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "create-release-plan": "cmd/create-release-plan.js",
    "generate-sdk": "cmd/generate-sdk.js",
    "update-sdk-details": "cmd/update-sdk-details.js"
  },
  "dependencies": {
    "@octokit/rest": "catalog:",
    "@azure-tools/specs-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
