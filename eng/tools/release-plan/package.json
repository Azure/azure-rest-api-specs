{
  "name": "@azure-tools/release-plan",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "create-release-plan": "cmd/create-release-plan.js",
    "generate-sdk": "cmd/generate-sdk.js",
    "update-sdk-details": "cmd/update-sdk-details.js"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@azure-tools/specs-shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "prettier . --ignore-path ../.prettierignore --write",
    "format:check": "prettier . --ignore-path ../.prettierignore --check",
    "format:check:ci": "prettier . --ignore-path ../.prettierignore --check --log-level debug",
    "lint": "cross-env DEBUG=eslint:eslint,eslint:linter eslint",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
