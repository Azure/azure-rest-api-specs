{
  "name": "@azure-tools/oav-runner",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "bin": {
    "oav-runner": "cmd/oav-runner.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "@azure-tools/specs-shared": "workspace:*",
    "@azure-tools/suppressions": "workspace:*",
    "js-yaml": "catalog:",
    "oav": "catalog:",
    "simple-git": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/js-yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "version": "0.0.0"
}
