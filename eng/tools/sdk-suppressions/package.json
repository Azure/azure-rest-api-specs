{
  "name": "@azure-tools/sdk-suppressions",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "version": "1.0.0",
  "bin": {
    "get-sdk-suppressions-label": "cmd/sdk-suppressions-label.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@azure-tools/specs-shared": "workspace:*",
    "ajv": "catalog:",
    "debug": "catalog:",
    "simple-git": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/debug": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
