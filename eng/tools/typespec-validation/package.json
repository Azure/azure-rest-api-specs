{
  "name": "@azure-tools/typespec-validation",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "tsv": "cmd/tsv.js"
  },
  "dependencies": {
    "@azure-tools/specs-shared": "workspace:*",
    "debug": "catalog:",
    "package-directory": "catalog:",
    "picocolors": "catalog:",
    "simple-git": "catalog:",
    "@azure-tools/suppressions": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/debug": "catalog:",
    "@types/node": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "version": "0.0.0"
}
