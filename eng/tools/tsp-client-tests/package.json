{
  "name": "@azure-tools/tsp-client-tests",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@azure-tools/specs-shared": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "version": "0.0.0"
}
