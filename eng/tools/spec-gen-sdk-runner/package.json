{
  "name": "@azure-tools/spec-gen-sdk-runner",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./azsdk-adapter": "./src/azsdk-adapter.ts",
    "./command-helpers": "./src/command-helpers.ts",
    "./emitter-check": "./src/emitter-check.ts",
    "./spec-helpers": "./src/spec-helpers.ts"
  },
  "version": "0.0.1",
  "bin": {
    "spec-gen-sdk-runner": "cmd/spec-gen-sdk-runner.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:update": "vitest --update",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@azure-tools/specs-shared": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
