{
  "name": "@azure-tools/openapi-diff-runner",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "openapi-diff-runner": "cmd/openapi-diff-runner.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "@azure-tools/specs-shared": "workspace:*",
    "@azure-tools/suppressions": "workspace:*",
    "@azure/oad": "catalog:",
    "simple-git": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "version": "0.0.0"
}
