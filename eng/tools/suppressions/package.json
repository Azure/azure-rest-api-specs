{
  "name": "@azure-tools/suppressions",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "get-suppressions": "cmd/get-suppressions.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test:ci",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "minimatch": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@azure-tools/specs-shared": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": "0.0.0"
}
