{
  "title": "Return structural validation failures without an HTTP error",
  "operationId": "PolicyMcp_VerifyPolicy",
  "parameters": {
    "api-version": "2025-05-01-preview",
    "body": {
      "policyDefinition": {
        "properties": {
          "mode": "All",
          "policyRule": {
            "if": {
              "field": "type",
              "equals": "Microsoft.Storage/storageAccounts"
            }
          }
        }
      }
    }
  },
  "responses": {
    "200": {
      "body": {
        "verificationResult": "FailedValidation",
        "validationErrors": [
          "The policy rule must include a then property."
        ]
      }
    }
  }
}
