{
  "title": "Simulate a hypothetical policy at management group scope",
  "operationId": "PolicyMcp_SimulatePolicyAtManagementGroupScope",
  "parameters": {
    "api-version": "2026-09-01-preview",
    "managementGroupId": "policy-preview-mg",
    "body": {
      "simulatedAssignment": {
        "policyDefinition": {
          "id": "/providers/Microsoft.Management/managementGroups/policy-preview-mg/providers/Microsoft.Authorization/policyDefinitions/hypothetical-location-audit",
          "properties": {
            "displayName": "Audit resources outside westus",
            "mode": "All",
            "policyRule": {
              "if": {
                "field": "location",
                "notEquals": "westus"
              },
              "then": {
                "effect": "audit"
              }
            }
          }
        }
      },
      "resource": {
        "resourceId": "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/policy-preview-rg/providers/Microsoft.Storage/storageAccounts/policypreviewstore",
        "apiVersion": "2023-05-01"
      },
      "policyTargets": []
    }
  },
  "responses": {
    "200": {
      "body": {
        "policyEvaluationResult": {
          "policyEvaluations": [
            {
              "policyInfo": {
                "policyDefinitionId": "/providers/Microsoft.Management/managementGroups/policy-preview-mg/providers/Microsoft.Authorization/policyDefinitions/hypothetical-location-audit",
                "policyAssignmentId": "/providers/Microsoft.Management/managementGroups/policy-preview-mg/providers/Microsoft.Authorization/policyAssignments/simulatePolicy"
              },
              "evaluationResult": "Compliant",
              "effectDetails": {
                "policyEffect": "Audit"
              }
            }
          ]
        }
      }
    }
  }
}
