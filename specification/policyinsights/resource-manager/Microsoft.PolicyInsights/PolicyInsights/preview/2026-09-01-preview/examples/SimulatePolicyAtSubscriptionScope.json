{
  "title": "Simulate a hypothetical policy at subscription scope",
  "operationId": "PolicyMcp_SimulatePolicyAtSubscriptionScope",
  "parameters": {
    "api-version": "2026-09-01-preview",
    "subscriptionId": "11111111-1111-1111-1111-111111111111",
    "body": {
      "simulatedAssignment": {
        "policyDefinition": {
          "id": "/subscriptions/11111111-1111-1111-1111-111111111111/providers/Microsoft.Authorization/policyDefinitions/hypothetical-secure-transfer",
          "properties": {
            "displayName": "Require secure transfer for storage accounts",
            "mode": "All",
            "policyRule": {
              "if": {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Storage/storageAccounts"
                  },
                  {
                    "field": "Microsoft.Storage/storageAccounts/supportsHttpsTrafficOnly",
                    "equals": false
                  }
                ]
              },
              "then": {
                "effect": "deny"
              }
            }
          }
        }
      },
      "resource": {
        "resourceId": "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/policy-preview-rg/providers/Microsoft.Storage/storageAccounts/policypreviewstore",
        "apiVersion": "2023-05-01",
        "resourceContent": {
          "id": "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/policy-preview-rg/providers/Microsoft.Storage/storageAccounts/policypreviewstore",
          "name": "policypreviewstore",
          "type": "Microsoft.Storage/storageAccounts",
          "location": "westus",
          "kind": "StorageV2",
          "sku": {
            "name": "Standard_LRS"
          },
          "properties": {
            "supportsHttpsTrafficOnly": false
          }
        }
      },
      "policyTargets": []
    }
  },
  "responses": {
    "200": {
      "body": {
        "policyEvaluationResult": {
          "policyEvaluations": [
            {
              "policyInfo": {
                "policyDefinitionId": "/subscriptions/11111111-1111-1111-1111-111111111111/providers/Microsoft.Authorization/policyDefinitions/hypothetical-secure-transfer",
                "policyAssignmentId": "/subscriptions/11111111-1111-1111-1111-111111111111/providers/Microsoft.Authorization/policyAssignments/simulatePolicy"
              },
              "evaluationResult": "NonCompliant",
              "effectDetails": {
                "policyEffect": "Deny"
              }
            }
          ]
        }
      }
    }
  }
}
