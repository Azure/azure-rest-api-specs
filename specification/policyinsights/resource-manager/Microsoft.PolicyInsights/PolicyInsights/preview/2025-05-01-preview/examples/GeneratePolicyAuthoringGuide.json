        "relevantAliases": [
          {
            "aliasName": "Microsoft.Storage/storageAccounts/supportsHttpsTrafficOnly",
            "aliasDescription": "Whether the storage account requires secure transfer.",
            "resourceType": "Microsoft.Storage/storageAccounts",
            "propertyPath": "properties.supportsHttpsTrafficOnly",
            "valueType": "boolean",
            "allowedValues": [
              "true",
              "false"
            ]
          }
        ],
        "relevantRuleExamples": [
          {
            "description": "Identify storage accounts that do not require secure transfer.",
            "ifCondition": "{\"allOf\":[{\"field\":\"type\",\"equals\":\"Microsoft.Storage/storageAccounts\"},{\"field\":\"Microsoft.Storage/storageAccounts/supportsHttpsTrafficOnly\",\"equals\":false}]}"
          }
        ],
        "relevantEffectExamples": [
          {
            "description": "Deny a noncompliant resource request.",
