      "post": {
        "operationId": "PolicyMcp_GeneratePolicyAuthoringGuide",
        "tags": [
          "PolicyMcp"
        ],
        "description": "Returns authoring syntax, relevant aliases, and policy rule and effect examples for the supplied intent.",
