      "post": {
        "operationId": "PolicyMcp_VerifyPolicy",
        "tags": [
          "PolicyMcp"
        ],
        "description": "Validates a policy definition and, if validation succeeds, lints it using the selected rule sets. Validation and lint failures are returned in a successful HTTP response.",
        "parameters": [
          {
            "$ref": "../../../../../../common-types/resource-management/v3/types.json#/parameters/ApiVersionParameter"
          },
          {
            "name": "body",
            "in": "body",
            "description": "The request body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/VerifyPolicyContent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "schema": {
              "$ref": "#/definitions/PolicyVerificationResult"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "../../../../../../common-types/resource-management/v3/types.json#/definitions/ErrorResponse"
            }
          }
        },
        "x-ms-examples": {
          "Return structural validation failures without an HTTP error": {
            "$ref": "./examples/VerifyPolicyValidationFailure.json"
