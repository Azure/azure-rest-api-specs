            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "../../../../../../common-types/resource-management/v3/types.json#/definitions/ErrorResponse"
            }
          }
        },
        "x-ms-examples": {
          "Retrieve authoring guidance for storage account secure transfer": {
            "$ref": "./examples/GeneratePolicyAuthoringGuide.json"
          }
        }
      }
    },
