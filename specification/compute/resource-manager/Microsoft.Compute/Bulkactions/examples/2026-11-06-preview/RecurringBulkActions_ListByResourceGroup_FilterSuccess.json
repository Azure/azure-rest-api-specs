              "schedule": {
                "scheduledTime": "07:00:00",
                "timeZone": "America/Los_Angeles",
                "requestedWeekDays": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday"
                ]
              },
              "notificationSettings": [],
              "disabled": false,
              "provisioningState": "Succeeded"
            },
            "location": "eastus",
            "id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/scheduledActions/weekday-start",
            "name": "weekday-start",
            "type": "microsoft.compute/scheduledActions"
          }
        ]
      }
    }
  }
}
