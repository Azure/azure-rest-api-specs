{
  "title": "List recurring bulk actions in a resource group filtered by name",
  "description": "Uses $filter to return only the recurring bulk actions whose name contains 'start'.",
  "operationId": "RecurringBulkActions_ListByResourceGroup",
  "parameters": {
    "api-version": "2026-11-06-preview",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "example-rg",
    "$filter": "contains(name, 'start')"
  },
