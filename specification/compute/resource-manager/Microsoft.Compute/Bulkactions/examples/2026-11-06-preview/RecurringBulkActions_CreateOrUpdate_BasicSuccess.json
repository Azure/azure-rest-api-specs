        "Azure-AsyncOperation": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/33333333-3333-3333-3333-333333333333?api-version=2026-11-06-preview"
      },
      "body": {
