{
  "title": "02 - Attach resources to a recurring bulk action with individual notification settings",
  "description": "Attaches two virtual machines to a recurring bulk action and configures different notification destinations for each resource. The initial response is 202 Accepted with no body; the 200 response shows the final result from the Location polling URL. An empty resourcesStatuses array means both resources succeeded. Completion does not mean the scheduled virtual machine operations have run.",
  "operationId": "RecurringBulkActions_AttachResources",
  "parameters": {
    "api-version": "2026-11-06-preview",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "example-rg",
    "recurringBulkActionName": "weekday-start",
    "body": {
      "resources": [
        {
          "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-01",
          "notificationSettings": [
            {
              "destination": "web-operations@contoso.com",
              "type": "Email",
              "language": "en-us",
              "disabled": false
            }
          ]
        },
        {
          "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02",
          "notificationSettings": [
            {
              "destination": "service-owners@contoso.com",
              "type": "Email",
              "language": "en-us",
              "disabled": false
            },
            {
              "destination": "audit@contoso.com",
              "type": "Email",
              "language": "en-us",
              "disabled": true
            }
          ]
        }
      ]
    }
  },
  "responses": {
    "202": {
      "headers": {
        "Azure-AsyncOperation": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/55555555-5555-5555-5555-555555555555?api-version=2026-11-06-preview",
        "Location": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/55555555-5555-5555-5555-555555555555?api-version=2026-11-06-preview&monitor=true"
      }
    },
    "200": {
      "body": {
        "totalResources": 2,
        "resourcesStatuses": []
      }
    }
  }
}
