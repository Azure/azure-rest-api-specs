{
  "title": "01 - Attach resources to a recurring bulk action",
  "description": "Attaches two virtual machines to a recurring bulk action. The initial response is 202 Accepted with no body; the 200 response shows the final result from the Location polling URL. An empty resourcesStatuses array means both resources succeeded. Completion does not mean the scheduled virtual machine operations have run.",
  "operationId": "RecurringBulkActions_AttachResources",
  "parameters": {
    "api-version": "2026-11-06-preview",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "example-rg",
    "scheduledActionName": "weekday-start",
    "body": {
      "resources": [
        {
          "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-01"
        },
        {
          "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02"
        }
      ]
    }
  },
  "responses": {
    "202": {
      "headers": {
        "Azure-AsyncOperation": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/00000000-0000-0000-0000-000000000000?api-version=2026-11-06-preview",
        "Location": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/00000000-0000-0000-0000-000000000000?api-version=2026-11-06-preview&monitor=true"
      }
    },
    "200": {
      "body": {
        "totalResources": 2,
        "resourcesStatuses": []
      }
    }
  }
}
