        "resourceType": "VirtualMachine",
        "actionType": "Start",
        "startTime": "2026-09-01T19:00:00-07:00",
        "endTime": "2027-09-01T19:00:00-07:00",
        "schedule": {
          "scheduledTime": "19:00:00",
          "timeZone": "America/Los_Angeles",
          "requestedWeekDays": [
            "All"
          ],
          "requestedMonths": [
            "All"
          ],
          "requestedDaysOfTheMonth": [
            1,
            15
