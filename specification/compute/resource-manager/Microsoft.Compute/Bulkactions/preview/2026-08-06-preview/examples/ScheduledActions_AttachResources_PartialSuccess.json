{
  "title": "Response with partial results when attaching resources to a recurring scheduled action",
  "description": "Attaches one resource to a recurring scheduled action and reports that a second resource is already attached.",
  "operationId": "ScheduledActions_AttachResources",
  "parameters": {
    "api-version": "2026-08-06-preview",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "example-rg",
    "scheduledActionName": "weekday-start",
    "body": {
      "resources": [
        {
          "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-01"
        },
        {
          "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02"
        }
      ]
    }
  },
  "responses": {
    "202": {
      "headers": {
        "Azure-AsyncOperation": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/66666666-6666-6666-6666-666666666666?api-version=2026-08-06-preview",
        "Location": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/66666666-6666-6666-6666-666666666666?api-version=2026-08-06-preview&monitor=true",
        "Retry-After": 10
      }
    },
    "200": {
      "body": {
        "totalResources": 2,
        "resourcesStatuses": [
          {
            "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-01",
            "status": "Succeeded"
          },
          {
            "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02",
            "status": "Failed",
            "error": {
              "code": "ResourceAlreadyAttached",
              "message": "Resource /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02 is already attached to scheduled action /subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/scheduledActions/weekday-start. Please use the patch API if you intend to update the resource details."
            }
          }
        ]
      }
    }
  }
}
