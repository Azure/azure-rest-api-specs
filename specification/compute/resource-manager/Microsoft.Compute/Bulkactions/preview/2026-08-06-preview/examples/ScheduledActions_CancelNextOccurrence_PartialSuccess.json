{
  "title": "Response with partial results when canceling the next recurring scheduled action occurrence",
  "description": "Cancels the next recurring scheduled action occurrence for one virtual machine and reports that the operation for a second virtual machine was already activated and cannot be canceled.",
  "operationId": "ScheduledActions_CancelNextOccurrence",
  "parameters": {
    "api-version": "2026-08-06-preview",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "example-rg",
    "scheduledActionName": "weekday-start",
    "body": {
      "resourceIds": [
        "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-01",
        "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02"
      ]
    }
  },
  "responses": {
    "202": {
      "headers": {
        "Azure-AsyncOperation": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/00000000-0000-0000-0000-000000000000?api-version=2026-08-06-preview",
        "Location": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/providers/Microsoft.Compute/locations/eastus/scheduledActionsOperationStatuses/00000000-0000-0000-0000-000000000000?api-version=2026-08-06-preview&monitor=true",
        "Retry-After": 10
      }
    },
    "200": {
      "body": {
        "totalResources": 2,
        "resourcesStatuses": [
          {
            "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02",
            "status": "Failed",
            "error": {
              "code": "OccurrenceCancelResourceRejected",
              "message": "operation already activated; cannot cancel",
              "target": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.Compute/virtualMachines/web-vm-02"
            }
          }
        ]
      }
    }
  }
}
