  /** Type of action of the operation */
  #suppress "@azure-tools/typespec-client-generator-core/csharp-no-type-name-conflict" "Name kept for backward compatibility"
  union AppAction {
    /** Web app was restarted. */
    "Restarted",

    /** Web app was stopped. */
