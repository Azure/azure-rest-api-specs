    /** family of app service plan sku. */
    #suppress "@azure-tools/typespec-azure-core/casing-style" "Modeling after original service swagger."
    Family?: string;

    /** capacity of app service plan sku. */
    #suppress "@azure-tools/typespec-azure-core/casing-style" "Modeling after original service swagger."
    Capacity?: string;
  }
