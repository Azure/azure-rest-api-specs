{
  "title": "PolicyGroups_CreateOrUpdate_McpRules",
  "operationId": "PolicyGroups_CreateOrUpdate",
  "parameters": {
    "api-version": "2026-11-03-preview",
    "subscriptionId": "11809CA1-E126-4017-945E-AA795CD5C5A9",
    "resourceGroupName": "rgnetworksecurity",
    "policyGroupName": "mcpRulesPolicyGroup",
    "resource": {
      "location": "eastus",
      "tags": {
        "env": "test"
      },
      "properties": {
        "displayName": "MCP rules",
        "description": "MCP policy rules: protocol versions, tool names, tool arguments and prompts",
        "priority": 100,
        "networkSecurityPolicies": [
          {
            "type": "Mcp",
            "defaultAction": "Deny",
            "source": {
              "type": "WorkloadIdPatterns",
              "patterns": [
                "spiffe://contoso.com/ns/agents/sa/*"
              ]
            },
            "destination": {
              "type": "Fqdns",
              "fqdns": [
                "mcp.deepwiki.com",
                "api.githubcopilot.com"
              ]
            },
            "rules": [
              {
                "name": "deny-old-protocol-versions",
                "priority": 50,
                "action": "Deny",
                "matchingConditions": {
                  "destinations": {
                    "protocolVersions": {
                      "values": [
                        "2024-11-05"
                      ],
                      "matchType": "ExactMatch"
                    }
                  }
                }
              },
              {
                "name": "no-secrets-in-questions",
                "priority": 100,
                "action": "Deny",
                "matchingConditions": {
                  "destinations": {
                    "toolMatching": {
                      "names": {
                        "values": [
                          "ask_wiki_question"
                        ],
                        "matchType": "ExactMatch"
                      },
                      "callArguments": {
                        "values": [
                          "password",
                          "secret",
                          "api_key"
                        ],
                        "matchType": "Contains",
                        "matchCase": "CaseInsensitive"
                      }
                    }
                  }
                }
              },
              {
                "name": "allow-issue-writes",
                "priority": 200,
                "action": "Allow",
                "matchingConditions": {
                  "destinations": {
                    "serverFqdns": [
                      "api.githubcopilot.com"
                    ],
                    "toolMatching": {
                      "names": {
                        "values": [
                          "create_issue",
                          "add_issue_comment"
                        ],
                        "matchType": "ExactMatch"
                      }
                    }
                  }
                }
              },
              {
                "name": "approved-repos-only",
                "priority": 300,
                "action": "Allow",
                "matchingConditions": {
                  "destinations": {
                    "serverFqdns": [
                      "mcp.deepwiki.com"
                    ],
                    "toolMatching": {
                      "names": {
                        "values": [
                          "read_wiki_structure",
                          "read_wiki_contents",
                          "ask_wiki_question"
                        ],
                        "matchType": "ExactMatch"
                      },
                      "callArguments": {
                        "path": "$.repoName",
                        "values": [
                          "microsoft/vscode"
                        ],
                        "matchType": "ExactMatch",
                        "matchCase": "CaseInsensitive"
                      }
                    }
                  }
                }
              },
              {
                "name": "code-review-prompt",
                "priority": 400,
                "matchingConditions": {
                  "destinations": {
                    "promptMatching": {
                      "names": {
                        "values": [
                          "code_review"
                        ],
                        "matchType": "ExactMatch"
                      }
                    }
                  }
                },
                "action": "Allow"
              }
            ]
          },
          {
            "type": "TlsInspection",
            "source": {
              "type": "WorkloadIdPatterns",
              "patterns": [
                "spiffe://contoso.com/ns/agents/sa/*"
              ]
            },
            "certificate": {
              "mode": "AzureManagedCA"
            },
            "defaultAction": "Inspect"
          }
        ]
      }
    }
  },
