                  "destinations": {
                    "promptMatching": {
                      "methods": [
                        "Get"
                      ],
                      "responseContents": {
                        "values": [
                          "password",
                          "secret",
                          "api_key"
                        ],
                        "matchType": "Contains",
                        "matchCase": "CaseInsensitive"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "Mcp",
            "source": {
              "type": "WorkloadIdPatterns",
              "patterns": [
                "spiffe://contoso.com/ns/default/sa/*"
              ]
            },
            "defaultAction": "Deny",
            "destination": {
              "type": "Fqdns",
              "fqdns": [
                "tools.contoso.com"
              ]
            },
