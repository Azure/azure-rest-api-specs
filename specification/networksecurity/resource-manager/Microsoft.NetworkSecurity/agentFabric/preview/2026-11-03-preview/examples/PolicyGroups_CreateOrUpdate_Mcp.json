      },
      "properties": {
        "displayName": "MCP Policy Group",
        "description": "A policy group demonstrating MCP server policies",
        "priority": 100,
        "networkSecurityPolicies": [
          {
            "type": "Mcp",
            "defaultAction": "Deny",
            "source": {
              "type": "WorkloadIdPatterns",
              "patterns": [
                "spiffe://contoso.com/ns/default/sa/*"
              ]
            },
            "destination": {
              "type": "Fqdns",
              "fqdns": [
                "search.contoso.com"
              ]
            },
            "rules": [
              {
                "name": "allow-search-and-fetch",
                "priority": 100,
                "action": "Allow",
                "matchingConditions": {
                  "destinations": {
                    "toolMatching": {
                      "names": {
                        "values": [
                          "search",
                          "fetch"
                        ],
                        "matchType": "ExactMatch"
                      }
                    }
                  }
                }
              },
              {
                "name": "deny-delete-file",
                "priority": 200,
                "action": "Deny",
                "matchingConditions": {
                  "destinations": {
                    "toolMatching": {
                      "names": {
                        "values": [
                          "deleteFile"
                        ],
                        "matchType": "ExactMatch"
                      }
                    }
