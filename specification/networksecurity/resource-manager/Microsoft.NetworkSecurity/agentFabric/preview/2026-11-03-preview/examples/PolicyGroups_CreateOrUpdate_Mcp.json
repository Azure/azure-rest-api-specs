              ]
            },
            "rules": [
              {
                "name": "deny-shell-and-writes",
                "priority": 100,
                "action": "Deny",
                "matchingConditions": {
                  "destinations": {
                    "toolMatching": {
                      "names": {
                        "values": [
                          "executeShell",
                          "writeFile"
                        ],
                        "matchType": "ExactMatch"
                      }
                    }
                  }
                }
              },
              {
                "name": "deny-injected-tool-descriptions",
                "priority": 200,
                "action": "Deny",
                "matchingConditions": {
                  "destinations": {
                    "toolMatching": {
                      "methods": [
                        "List"
                      ],
                      "descriptions": {
                        "values": [
                          "ignore previous instructions",
                          "do not tell the user"
                        ],
                        "matchType": "Contains",
                        "matchCase": "CaseInsensitive"
                      }
                    }
                  }
                }
              },
              {
                "name": "deny-secrets-in-tool-results",
                "priority": 300,
                "action": "Deny",
                "matchingConditions": {
                  "destinations": {
                    "toolMatching": {
                      "methods": [
                        "Call"
                      ],
                      "responseContents": {
                        "values": [
                          "password",
                          "secret",
                          "api_key"
                        ],
                        "matchType": "Contains",
                        "matchCase": "CaseInsensitive"
                      }
                    }
                  }
                }
              },
              {
                "name": "deny-secrets-in-prompt-results",
                "priority": 400,
                "action": "Deny",
