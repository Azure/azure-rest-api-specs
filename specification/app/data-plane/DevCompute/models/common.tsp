using Http;
using Azure.Core;
using Azure.Core.Traits;

namespace AzureDevCompute;

/** Standard Azure Core traits for ADC operations without conditional, repeatable, or client request ID semantics. */
alias DataPlaneStandardTraits = NoConditionalRequests &
  NoRepeatableRequests &
  NoClientRequestId;

/** Azure Dev Compute error object. */
@error
model ProblemDetails {
  /** A URI reference identifying the problem type. */
  type?: string;

  /** A short summary of the problem. */
  title?: string;

  /** The HTTP status code generated by the origin server. */
  status?: int32;

  /** A human-readable explanation of the problem. */
  detail?: string;

  /** A URI reference identifying the specific problem occurrence. */
  instance?: string;
}

/** An error response with an HTTP status code and error body. */
#suppress "@azure-tools/typespec-client-generator-core/csharp-model-suffix" "This generic model is an HTTP response wrapper, not an emitted SDK data model; its C# client name is configured as ErrorResult in client.tsp."
@error
model ErrorResponse<Status extends int32> {
  /** HTTP status code. */
  @statusCode statusCode: Status;

  /** Error response body. */
  @body body: ProblemDetails;
}

/** Response with a 500 status code and no guaranteed response body. */
@error
model InternalServerErrorNoBody {
  /** HTTP status code. */
  @statusCode statusCode: 500;
}

/** Azure resource scope shared by Azure-scoped resource routes. */
model AzureResourceScope {
  /** Azure subscription identifier. */
  @path subscriptionId: string;

  /** Azure resource group name. */
  @path resourceGroupName: string;

  /** ADC sandbox group name. */
  @path sandboxGroupName: string;
}

/** EntityTagHeaderValue wire model. */
model EntityTagHeaderValue {
  /** tag value. */
  tag?: StringSegment;

  /** isWeak value. */
  isWeak?: boolean;
}

/** FileStreamResult wire model. */
model FileStreamResult {
  /** fileStream value. */
  fileStream?: Stream;

  /** contentType value. */
  contentType?: string;

  /** fileDownloadName value. */
  fileDownloadName?: string;

  /** lastModified value. */
  lastModified?: utcDateTime;

  /** entityTag value. */
  entityTag?: EntityTagHeaderValue;

  /** enableRangeProcessing value. */
  enableRangeProcessing?: boolean;
}

/** AbsoluteDirectoryPath wire model. */
scalar AbsoluteDirectoryPath extends string;

/** AbsoluteFilePath wire model. */
scalar AbsoluteFilePath extends string;

/** Bytes wire model. */
scalar Bytes extends bytes;

/** Strongly-typed connection identifier. ConnectionId is intentionally string-based rather than Guid-based because existing Cosmos DB documents contain connection IDs in mixed formats — some with hyphens (Guid "D" format: a1b2c3d4-e5f6-...) and some without (Guid "N" format: a1b2c3d4e5f6...). Converting to a Guid-backed typed ID would normalize all lookups to the "D" format via Guid.ToString(), breaking reads/deletes of documents stored with the "N" format since Cosmos DB performs exact string matching on document IDs. */
scalar ConnectionId extends string;

/** SandboxId wire model. */
scalar SandboxId extends string;

/** Stream wire model. */
scalar Stream extends bytes;

/** StringSegment wire model. */
model StringSegment {
  /** buffer value. */
  buffer?: string;

  /** offset value. */
  offset?: int32;

  /** length value. */
  length?: int32;

  /** value value. */
  value?: string;

  /** hasValue value. */
  hasValue?: boolean;
}
