{
  "operationId": "AzureSandboxes_create",
  "title": "AzureSandboxes_create - pod",
  "parameters": {
    "endpoint": "https://example.azuredevcompute.io",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroupName": "example-resource-group",
    "sandboxGroupName": "example-sandbox-group",
    "api-version": "2026-08-01-preview",
    "request": {
      "labels": {
        "environment": "example"
      },
      "resources": {
        "cpu": "1",
        "memory": "1Gi"
      },
      "sourcesRef": {
        "pod": {
          "containers": [
            {
              "name": "main",
              "diskImage": {
                "id": "example-disk-image"
              }
            }
          ]
        }
      }
    }
  },
  "responses": {
    "201": {
      "body": {
        "id": "example-sandbox",
        "vmmType": "cloudhypervisor",
        "sourcesRef": {},
        "resources": {
          "cpu": "example-cpu",
          "memory": "example-memory"
        }
      }
    }
  }
}
