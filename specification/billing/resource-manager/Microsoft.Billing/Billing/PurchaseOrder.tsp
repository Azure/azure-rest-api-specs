import "@azure-tools/typespec-azure-core";
import "@azure-tools/typespec-azure-resource-manager";
import "@typespec/rest";
import "@typespec/versioning";
import "./models.tsp";
import "./BillingProfile.tsp";

using Azure.ResourceManager;
using TypeSpec.Http;
using TypeSpec.Rest;
using TypeSpec.Versioning;

namespace Microsoft.Billing;

/**
 * The purchase order.
 */
@added(Versions.v2024_08_01_preview)
@tenantResource
@parentResource(BillingProfile)
model PurchaseOrder
  is Azure.ResourceManager.ProxyResource<PurchaseOrderProperties> {
  ...ResourceNameParameter<
    Resource = PurchaseOrder,
    KeyName = "poNumber",
    SegmentName = "purchaseOrders",
    NamePattern = PoNumberPattern
  >;
}

alias PurchaseOrderListParameters = {
  /**
   * Can be used to get only active purchase orders.
   */
  @query
  allowOnlyActive?: boolean = false;

  /**
   * Token generated by the service to indicate the starting point for retrieving the next page of results.
   */
  @query("$skipToken")
  skipToken?: string;

  /**
   * The top query option requests the number of items in the queried collection to be included in the result. The maximum supported value for top is 50.
   */
  @minValue(1)
  @maxValue(50)
  @query("$top")
  top?: int32 = 50;
};

alias PurchaseOrderByBillingAccountOps = Azure.ResourceManager.Legacy.ExtensionOperations<
  {
    ...ApiVersionParameter;

    /** The resource provider namespace. */
    @path
    @segment("providers")
    @key
    providerNamespace: "Microsoft.Billing";

    /** The ID that uniquely identifies a billing account. */
    @path
    @segment("billingAccounts")
    @key
    @pattern(BillingAccountNamePattern)
    billingAccountName: string;
  },
  {},
  {
    /** The purchase order (PO) number. */
    @path
    @segment("purchaseOrders")
    @key
    @pattern(PoNumberPattern)
    poNumber: string;
  },
  "BillingAccountPurchaseOrder"
>;

#suppress "@azure-tools/typespec-azure-resource-manager/no-resource-delete-operation" "Purchase orders do not support deletion."
@armResourceOperations(#{ omitTags: true })
interface PurchaseOrders {
  /**
   * Gets a purchase order by its ID for a billing profile.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  getByBillingProfile is ArmResourceRead<
    PurchaseOrder,
    BaseParameters = Azure.ResourceManager.Foundations.TenantBaseParameters
  >;

  /**
   * Creates or updates a purchase order for a billing profile.
   */
  #suppress "@azure-tools/typespec-azure-resource-manager/arm-put-operation-response-codes" "The existing purchase order endpoint returns only 200."
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  updateByBillingProfile is ArmResourceCreateOrReplaceAsync<
    PurchaseOrder,
    BaseParameters = Azure.ResourceManager.Foundations.TenantBaseParameters,
    Response = ArmResponse<PurchaseOrder>
  >;

  /**
   * Gets a list of purchase orders for a billing profile.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  listByBillingProfile is ArmResourceListByParent<
    PurchaseOrder,
    BaseParameters = Azure.ResourceManager.Foundations.TenantBaseParameters,
    Parameters = PurchaseOrderListParameters,
    Response = ArmResponse<PurchaseOrderListResult>
  >;

  /**
   * Gets the unbilled charge summary for a purchase order in a billing profile.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  @action("fetchUnbilledChargeSummary")
  getUnbilledChargeSummaryByBillingProfile is ArmResourceActionSync<
    PurchaseOrder,
    void,
    ArmResponse<PurchaseOrderTransactionSummary>,
    BaseParameters = Azure.ResourceManager.Foundations.TenantBaseParameters
  >;

  /**
   * Gets a purchase order by its ID for a billing account. The operation is supported only for billing accounts with agreement type Enterprise Agreement.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  get is PurchaseOrderByBillingAccountOps.Read<PurchaseOrder>;

  /**
   * Creates or updates a purchase order for a billing account. The operation is supported only for billing accounts with agreement type Enterprise Agreement.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  update is PurchaseOrderByBillingAccountOps.CreateOrUpdateSync<
    PurchaseOrder,
    Response = ArmResponse<PurchaseOrder>
  >;

  /**
   * Gets a list of purchase orders for a billing account. The operation is supported only for billing accounts with agreement type Enterprise Agreement.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  listByBillingAccount is PurchaseOrderByBillingAccountOps.List<
    PurchaseOrder,
    Parameters = PurchaseOrderListParameters,
    Response = ArmResponse<PurchaseOrderListResult>
  >;

  /**
   * Gets the unbilled charge summary for a purchase order in a billing account. The operation is supported only for billing accounts with agreement type Enterprise Agreement.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  @action("fetchUnbilledChargeSummary")
  getUnbilledChargeSummaryByBillingAccount is PurchaseOrderByBillingAccountOps.ActionSync<
    PurchaseOrder,
    void,
    ArmResponse<PurchaseOrderTransactionSummary>
  >;
}

@armResourceOperations(#{ omitTags: true })
interface InvoiceSummaries {
  /**
   * Gets the active invoice summaries for a purchase order in a billing profile.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  @action("listInvoiceSummaries")
  listByBillingProfilePurchaseOrder is ArmResourceActionSync<
    PurchaseOrder,
    void,
    ArmResponse<PurchaseOrderInvoiceSummary[]>,
    BaseParameters = Azure.ResourceManager.Foundations.TenantBaseParameters
  >;

  /**
   * Gets the active invoice summaries for a purchase order in a billing account. The operation is supported only for billing accounts with agreement type Enterprise Agreement.
   */
  @added(Versions.v2024_08_01_preview)
  @tag("PurchaseOrder")
  @action("listInvoiceSummaries")
  listByBillingAccountPurchaseOrder is PurchaseOrderByBillingAccountOps.ActionSync<
    PurchaseOrder,
    void,
    ArmResponse<PurchaseOrderInvoiceSummary[]>
  >;
}
