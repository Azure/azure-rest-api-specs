import "../../foundry-common/models.tsp";
import "../simulations_common.tsp";

using TypeSpec.OpenAPI;
using Azure.Core;

namespace Azure.AI.Projects;

@extension("x-ms-foundry-meta", SimulationsRequiredPreviews)
model UserConversationRunItem {
  @doc("Type of simulation run item. Must be user_conversation.")
  type: SimulationType.user_conversation;

  @visibility(Lifecycle.Read)
  @doc("Message list for this conversation item. Uses the shared multimodal content-part model so the payload can carry text and future modalities.")
  messages: FoundryMessage[];

  @doc("Audio playback URI for the generated conversation audio, when available.")
  conversation_audio_uri?: string;
}

@extension("x-ms-foundry-meta", SimulationsRequiredPreviews)
union SimulationRunItem {
  UserConversationRunItem,
}

@extension("x-ms-foundry-meta", SimulationsRequiredPreviews)
model SimulationRunResult {
  @doc("Dataset generated by the simulation run when result dataset generation is enabled.")
  @visibility(Lifecycle.Read)
  dataset?: FoundryDatasetReference;
}

@doc("A simulation run that follows the standard Foundry long-running job lifecycle. Creation fields are exposed directly on the resource instead of under an `inputs` object.")
@extension("x-ms-foundry-meta", SimulationsRequiredPreviews)
model SimulationRun is JobLike<SimulationRunResult, never> {
  @doc("Optional human-readable name for the simulation run. Use this field to identify the run in lists, logs, and user interfaces.")
  @maxLength(256)
  name?: string;

  @doc("Name of the simulation configuration used by this run. Together with `configuration_version`, this selects one exact configuration version.")
  configuration_name: string;

  @doc("Version of the simulation configuration used by this run. Together with `configuration_name`, this selects one exact configuration version.")
  configuration_version: string;

  @doc("Target configuration override for this particular simulation run. When omitted, the run uses the configuration-level default simulation target.")
  target?: SimulationTargetConfiguration;

  @doc("Model configuration override for this simulation run. When omitted, the run uses the configuration-level default model configuration.")
  model_configuration?: SimulationModelConfiguration;

  @doc("Whether the service should generate and expose a result dataset for this run. Defaults to `false`.")
  enable_dataset_generation?: boolean = false;

  @doc("Timestamp when the simulation run was created.")
  @visibility(Lifecycle.Read)
  created_at: FoundryTimestamp;

  @doc("Timestamp when the simulation run reached a terminal state.")
  @visibility(Lifecycle.Read)
  finished_at?: FoundryTimestamp;
}
