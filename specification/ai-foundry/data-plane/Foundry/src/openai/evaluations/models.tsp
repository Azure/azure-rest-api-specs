  OpenAI.EvalGraderTextSimilarity,
  "A grader that compares text by using a similarity metric. See [textual similarity evaluators](https://learn.microsoft.com/en-us/azure/foundry/concepts/evaluation-evaluators/textual-similarity-evaluators)."
);

@@doc(
  OpenAI.EvalGraderScoreModel,
