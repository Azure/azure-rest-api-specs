@@doc(
  OpenAI.CreateEvalRequest.data_source_config,
  """
    Defines the schema and kind of data that evaluation runs must provide. This
    property configures the evaluation; it does not contain the run's data.
    Supply the actual dataset, inline items, stored responses, traces, or target
    configuration in `data_source` when creating an evaluation run.
    """
);

/** Adding Azure AI Evaluator and inspect_ai types to testing criteria for foundry extension. */
