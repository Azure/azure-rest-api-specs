using Azure.Core.Experimental;
using TypeSpec.Versioning;

namespace Azure.AI.Projects;

/** The object type for evaluation deletion responses. */
union EvalObjectType {
  evalDeleted: "eval.deleted",
}

/** The result of deleting an evaluation. */
#suppress "@azure-tools/typespec-client-generator-core/csharp-model-suffix" "Name kept for backward compatibility"
model DeleteEvalResponse {
  @doc("The object type. Always `eval.deleted`.")
  object: EvalObjectType.evalDeleted;

  @doc("The identifier of the deleted evaluation.")
  eval_id: string;

  @doc("Whether the evaluation was deleted.")
  deleted: boolean;
}

/** The result of deleting an evaluation run. */
#suppress "@azure-tools/typespec-client-generator-core/csharp-model-suffix" "Name kept for backward compatibility"
model DeleteEvalRunResponse {
  @doc("The object type. Always `eval.deleted` when provided.")
  object?: "eval.deleted";

  @doc("The identifier of the deleted evaluation run.")
  run_id?: string;

  @doc("Whether the evaluation run was deleted.")
  deleted?: boolean;
}

@doc("The level at which evaluation is performed.")
union EvaluationLevel {
  @doc("Evaluation is performed at the turn level.")
  turn: "turn",

  @doc("Evaluation is performed at the conversation level.")
  conversation: "conversation",

  string,
}

/**
 * An Azure AI evaluator used as a grader.
 *
 * See the [built-in evaluators reference](https://learn.microsoft.com/en-us/azure/foundry/concepts/built-in-evaluators).
 */
model GraderAzureAIEvaluator {
  /** The object type, which is always `azure_ai_evaluator`. */
  type: "azure_ai_evaluator";

  /**
   * A caller-defined name that identifies this testing criterion in the
   * evaluation configuration and run results.
   */
  name: string;

  /**
   * The registered name of the evaluator implementation to run. Built-in
   * evaluators use names in the `builtin.<evaluator>` format. Custom evaluators
   * use the registered name assigned to the evaluator.
   *
   * Available evaluator families include [general-purpose evaluators](https://learn.microsoft.com/en-us/azure/foundry/concepts/evaluation-evaluators/general-purpose-evaluators),
   * [risk and safety evaluators](https://learn.microsoft.com/en-us/azure/foundry/concepts/evaluation-evaluators/risk-safety-evaluators),
   * and [agent evaluators](https://learn.microsoft.com/en-us/azure/foundry/concepts/evaluation-evaluators/agent-evaluators).
   */
  evaluator_name: string;

  /** The version of the evaluator. Latest version if not specified. */
  evaluator_version?: string;

  /**
   * Evaluator-specific configuration applied when the evaluator is initialized.
   * Accepted parameters and defaults depend on the selected evaluator and
   * version. AI-assisted evaluators require a judge model setting, such as
   * `model` or `deployment_name`, that identifies a chat-completion deployment
   * in the current project. The judge model must support structured outputs.
   * Evaluators without required initialization parameters can omit this
   * property and use their documented defaults.
   */
  initialization_parameters?: Record<unknown>;

  /**
   * Maps the evaluator's input names to fields in the evaluation data. Use
   * `{{item.<field>}}` to reference a field from a dataset item and
   * `{{sample.<field>}}` to reference output generated by a model or agent
   * target. Field names are case-sensitive.
   *
   * This property can be omitted when the evaluator uses standard dataset
   * columns with matching names. Provide a mapping when dataset columns use
   * different names, when a target generates the response at run time, or when
   * the evaluator consumes structured target output.
   */
  data_mapping?: Record<string>;
}

/**
 * An Azure AI evaluator grader used as a testing criterion.
 *
 * See [rubric-based evaluators](https://learn.microsoft.com/en-us/azure/foundry/concepts/evaluation-evaluators/rubric-evaluators).
 */
@summary("AzureAIEvaluatorGrader")
model TestingCriterionAzureAIEvaluator {
  ...GraderAzureAIEvaluator;
}

/** Grader inspect_ai definition for inspect_ai benchmark evaluators. */
model EvalGraderInspectAI {
  /** The object type, which is always `inspect_ai`. */
  type: "inspect_ai";

  /** The display name of the benchmark. */
  name: string;

  /** The inspect_ai task module path (e.g., `inspect_evals/aime2025`). */
  task_name: string;
}

/** Base class for run data sources with discriminator support. */
@discriminator("type")
model DataSourceConfig {
  /** The data source type discriminator. */
  type: string;

  /**
   * The overall object JSON schema for the run data source items.
   *
   * See the [evaluation dataset schema](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/evaluation-dataset-schema).
   */
  schema: Record<unknown>;
}

/** Base data source configuration for Azure AI evaluation scenarios. */
@discriminator("scenario")
model AzureAIDataSourceConfig extends DataSourceConfig {
  /** The object type, which is always `azure_ai_source`. */
  type: "azure_ai_source";

  /** Data schema scenario. */
  #suppress "@azure-tools/typespec-azure-core/no-unnamed-types" "Auto-suppressed warnings non-applicable rules during import."
  scenario:
    | "red_team"
    | "responses"
    | "traces"
    | "synthetic_data_gen"
    | "benchmark_preview";
}

/** The set of available benchmark specifications. */
union BenchmarkName {
  string,

  /** GPQA Diamond — graduate-level science reasoning. */
  builtinGPQADiamond: "builtin.gpqa_diamond",

  /** BBEH — BIG-Bench Extra Hard. */
  builtinBBEH: "builtin.bbeh",

  /** BIG-Bench Hard — challenging BIG-Bench tasks. */
  builtinBigBenchHard: "builtin.bigbenchhard",

  /** FrontierScience — frontier scientific reasoning. */
  builtinFrontierScience: "builtin.frontierscience",

  /** IFEval — instruction-following evaluation. */
  builtinIFEval: "builtin.ifeval",

  /** MuSR — multi-step reasoning. */
  builtinMuSR: "builtin.musr",

  /** TruthfulQA — truthfulness evaluation. */
  builtinTruthfulQA: "builtin.truthful_qa",

  /** AIME 2025 via inspect_ai framework. */
  builtinInspectAIAIME2025: "builtin.inspect_ai.aime2025",

  /** BrowseComp via inspect_ai framework — web browsing agent benchmark. */
  builtinInspectAIBrowseComp: "builtin.inspect_ai.browse_comp",

  /** ChemBench via inspect_ai framework — chemistry reasoning. */
  builtinInspectAIChemBench: "builtin.inspect_ai.chembench",

  /** Tau2-Bench Telecom via inspect_ai framework — dual-agent telecom benchmark. */
  builtinInspectAITau2Telecom: "builtin.inspect_ai.tau2_telecom",
}

/** Data source configuration for benchmark evaluations. */
model AzureAIBenchmarkDataSourceConfig extends AzureAIDataSourceConfig {
  /** Data schema scenario, always `benchmark` for benchmark evaluations. */
  scenario: "benchmark_preview";

  /** The name of the benchmark specification. */
  benchmark_name: BenchmarkName;

  /** The version of the benchmark specification (e.g., '0.1'). Latest version if not specified. */
  benchmark_version?: string;

  /** Optional grader model for benchmarks that use model graders, Required when the benchmark's testing_criteria uses a model grader type. */
  grader_model?: string;
}

