);

@@doc(
  OpenAI.EvalGraderPython,
  "A grader that runs custom Python evaluation logic. See [custom evaluators](https://learn.microsoft.com/en-us/azure/foundry/concepts/evaluation-evaluators/custom-evaluators)."
);

/**
 * The request used to create an evaluation.
 *
 * See the [built-in evaluators reference](https://learn.microsoft.com/en-us/azure/foundry/concepts/built-in-evaluators)
 * when selecting testing criteria.
 */
#suppress "@azure-tools/typespec-client-generator-core/csharp-model-suffix" "Name kept for backward compatibility"
model CreateEvalRequest is OpenAI.CreateEvalRequest {
  /**
    Set of immutable 16 key-value pairs that can be attached to an object for storing additional information.
    Keys are strings with a maximum length of 64 characters. Values are strings with a maximum length of 512 characters.
  */
  properties?: Record<string>;
}

/** Identifies how evaluation input items are prepared before evaluation. */
union ItemGenerationParamsType {
  string,

  /** Parameters for red team. */
  redTeam: "red_team",

  /** The ResponseRetrieval item generation parameters. */
  responseRetrieval: "response_retrieval",

  /** Parameters for red team seed prompts. */
  redTeamSeedPrompts: "red_team_seed_prompts",

  /** Parameters for red team taxonomy item generation. */
  redTeamTaxonomy: "red_team_taxonomy",

  /** Parameters for synthetic data item generation. */
  syntheticDataGeneration: "synthetic_data_gen",

  /** Parameters for target completion item generation. */
  targetCompletion: "target_completion",
}

/** The types of parameters for synthetic data generation item generation. */
union SyntheticDataGenItemGenerationParamsType {
  string,

  /** Parameters for synthetic data generation. */
  syntheticDataGeneration: "synthetic_data_gen",
}

/**
 * Configures how the service prepares input items for an evaluation run before applying testing criteria.
 *
 * Depending on `type`, preparation can generate new inputs, retrieve existing responses, transform source data, or simulate conversations. Each `type` selects a workflow-specific model with the parameters required by that preparation workflow. These parameters do not define the evaluated target or the testing criteria.
 */
@discriminator("type")
model ItemGenerationParams {
  /** Preparation workflow to use. This discriminator determines which additional parameters are available. */
  type: ItemGenerationParamsType;
}

/** Represents the parameters for red team item generation. */
model RedTeamItemGenerationParams extends ItemGenerationParams {
  /** The type of item generation parameters. */
  type: ItemGenerationParamsType.redTeam;

  /** The collection of attack strategies to be used. */
  attack_strategies: AttackStrategy[];

  /** The number of turns allowed in the game. */
  num_turns: int32 = 20;
}

/** Represents the parameters for red team seed prompts item generation. */
model RedTeamSeedPromptsItemGenerationParams extends ItemGenerationParams {
  /** The type of item generation parameters, always `red_team_seed_prompts`. */
  type: ItemGenerationParamsType.redTeamSeedPrompts;

  /** The collection of attack strategies to be used. */
  attack_strategies: AttackStrategy[];

  /** The number of turns allowed in the game. */
  num_turns: int32 = 20;

  /** The source of JSONL content to be processed. */
  source: OpenAI.EvalJsonlFileContentSource;
}

/** Represents the parameters for red team taxonomy item generation. */
model RedTeamTaxonomyItemGenerationParams extends ItemGenerationParams {
  /** The type of item generation parameters, always `red_team_taxonomy`. */
  type: ItemGenerationParamsType.redTeamTaxonomy;

  /** The collection of attack strategies to be used. */
  attack_strategies: AttackStrategy[];

  /** The number of turns allowed in the game. */
  num_turns: int32 = 20;

  /** The source from which JSONL content is read. */
  source: OpenAI.EvalJsonlFileContentSource;
}

/**
 * Parameters for retrieving deployed conversations for evaluation.
 *
 * See [evaluate deployed conversations](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/cloud-evaluation-deployed-conversations?tabs=python).
 */
model ResponseRetrievalItemGenerationParams extends ItemGenerationParams {
  /** The type of item generation parameters, always `response_retrieval`. */
  type: ItemGenerationParamsType.responseRetrieval;

  /** The maximum number of turns of chat history to evaluate. */
  max_num_turns: int32;

  /**
   * Maps `response_id` to the source field that contains a stored Responses API
   * response identifier. For example, `{"response_id": "{{item.resp_id}}"}`.
   * Field names are case-sensitive.
   */
  data_mapping: Record<string>;

  /**
   * The inline JSONL content containing the response identifiers to retrieve.
   * The `azure_ai_responses` data source supports `file_content` only;
   * providing a `file_id` results in a `400 Bad Request` response.
   */
  #suppress "@azure-tools/typespec-autorest/union-unsupported" "This union is defined according to the Azure OpenAI API."
  #suppress "@azure-tools/typespec-azure-core/no-unnamed-types" "Auto-suppressed warnings non-applicable rules during import."
  source: OpenAI.EvalJsonlFileContentSource | OpenAI.EvalJsonlFileIdSource;
}

/**
 * A target that identifies an Azure AI model.
 *
 * See [evaluate administrator-connected models](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/evaluate-admin-connected-models?tabs=python).
 */
model AzureAIModelTarget extends FoundryEvaluationTarget {
  /** The type of target, always `azure_ai_model`. */
  type: "azure_ai_model";

  /** The name of the model deployment to invoke as the evaluation target. */
  `model`?: string;

  /** The parameters used to control the sampling behavior of the model during text generation. */
  sampling_params?: ModelSamplingParams;
}

/**
 * A target that identifies an Azure AI agent.
 *
 * See [evaluate model or agent targets](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/cloud-evaluation-targets?tabs=python).
 */
model AzureAIAgentTarget extends FoundryEvaluationTarget {
  /** The type of target, always `azure_ai_agent`. */
  type: "azure_ai_agent";

  /** The name of the Azure AI agent to invoke as the evaluation target. */
  name: string;

  /** The version of the Azure AI agent. When omitted, the latest version is used. */
  version?: string;

  /** Optional descriptions of tools available to the agent. */
  tool_descriptions?: ToolDescription[];

  /** Tool definitions made available when invoking the agent. */
  tools?: OpenAI.Tool[];
}

/** Description of a tool that can be used by an agent. */
model ToolDescription {
  /** The name of the tool. */
  name?: string;

  /** A brief description of the tool's purpose. */
  description?: string;
}

/** Represents a set of parameters used to control the sampling behavior of a language model during text generation. */
model ModelSamplingParams {
  /** The temperature parameter for sampling. Defaults to 1.0. */
  temperature?: float32 = 1.0;

  /** The top-p parameter for nucleus sampling. Defaults to 1.0. */
  top_p?: float32 = 1.0;

  /** The random seed for reproducibility. Defaults to 42. */
  seed?: int32 = 42;

  /** The maximum number of tokens allowed in the completion. */
  max_completion_tokens?: int32;
}

/** Base class for run data sources with discriminator support. */
@discriminator("type")
model EvalRunDataSource {
  /** The data source type discriminator. */
  type: string;
}

/**
 * A data source for evaluation runs over agent traces stored in Application Insights.
 *
 * See [create an evaluation dataset from traces](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/traces-to-dataset?tabs=python).
 */
model TracesEvalRunDataSource extends EvalRunDataSource {
  /** The type of data source, always `azure_ai_traces`. */
  type: "azure_ai_traces";

  /** Collection of Agent trace identifiers that should be evaluated. */
  trace_ids?: string[];

  /** Collection of conversation identifiers to filter traces by conversation. */
  conversation_ids?: string[];

  /** The agent ID used to filter traces for evaluation. */
  agent_id?: string;

  /** The agent name used to filter traces for evaluation. */
  agent_name?: string;

  /**
    Lookback window (in hours) applied when retrieving traces from Application Insights.
    For scheduled evaluations this is inferred from the recurrence interval.
  */
  lookback_hours?: int32 = 168;

  /** Unix timestamp (in seconds) marking the end of the trace query window. Defaults to the current time. */
  end_time?: FoundryTimestamp;

  /** Sampling limit applied to traces retrieved for evaluation. */
  max_traces?: int32 = 1000;

  /**
   * The delay to apply for ingestion when querying traces.
   */
  @encode(DurationKnownEncoding.seconds, int32)
  ingestion_delay_seconds?: duration = duration.fromISO("PT5M");
}

/**
 * A data source that generates synthetic data for an evaluation run.
 *
 * See [generate synthetic data for cloud evaluation](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/cloud-evaluation-synthetic-data?tabs=python)
 * and [generate a synthetic evaluation dataset](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/evaluation-dataset-synthetic?tabs=python).
 */
model SyntheticDataGenerationEvalRunDataSource extends EvalRunDataSource {
  /** The type of data source, always `azure_ai_synthetic_data_gen`. */
  type: "azure_ai_synthetic_data_gen";

  /** Configuration for generating the synthetic input items evaluated by this run. */
  item_generation_params: SyntheticDataGenerationItemGenerationParams;

  /** The target configuration for the evaluation. */
  target: FoundryEvaluationTarget;

  /** The message template sent to the target. This property applies only when `target.type` is `azure_ai_model`. */
  input_messages?: OpenAI.CreateEvalResponsesRunDataSourceInputMessagesTemplate;
}

/** Represents the parameters for synthetic data generation item generation. */
model SyntheticDataGenerationItemGenerationParams extends ItemGenerationParams {
  /** The type of item generation parameters. */
  type: ItemGenerationParamsType.syntheticDataGeneration;

  /** The maximum number of data samples to generate. */
  samples_count: int32;

  /** The prompt used to generate synthetic data. This property is optional when the target is an agent that already has instructions. */
  prompt?: string;

  /** The name of the model deployment to use for generating synthetic data. */
  model_deployment_name: string;

  /** The name of the output dataset where generated synthetic data will be stored. If not provided, service generates dataset name automatically. */
  output_dataset_name?: string;

  /** The identifier of the output dataset where generated synthetic data is stored. The generated data is a jsonl file with columns id, query and test_description. */
  @visibility(Lifecycle.Read)
  output_dataset_id?: string;

  /** The optional seed data content source files for data generation. */
  sources: OpenAI.EvalJsonlFileIdSource[];
}

/**
 * Generates seed test-case scenarios via the data generation endpoint and then evaluates a `target`
 * by simulating multi-turn user conversations over those scenarios.
 *
 * The `generation_sources` in `synthetic_data_generation_configuration` are forwarded to the data
 * generation backend to produce seed test cases. Each generated scenario is then simulated against
 * `target`: the model in `model_configuration` plays the simulated user and drives the conversation
 * according to `default_simulation_configuration` until it reaches the desired length or maximum turn
 * limit. The evaluation's testing criteria are then applied to the generated conversations.
 */
model SyntheticDataGenerationWithSimulationEvalRunDataSource
  extends EvalRunDataSource {
  /** The type of data source, always `azure_ai_synthetic_data_generation_with_simulation`. */
  type: "azure_ai_synthetic_data_generation_with_simulation";

  /** Seed data-generation configuration: how many test cases to generate, the optional output dataset name, and the generation sources forwarded to the data generation endpoint. */
  synthetic_data_generation_configuration: SyntheticDataGenerationConfiguration;

  /** Model used both to generate the seed test cases and to simulate the user side of each conversation against the evaluated `target`. */
  model_configuration: EvaluationModelConfiguration;

  /** Default configuration for the simulated conversations produced from the seed test cases, reusing the user conversation simulation contract. Includes the conversation dataset persistence controls (`enable_conversation_dataset_generation` and `output_conversation_dataset_name`). When omitted, the service defaults apply. */
  default_simulation_configuration?: UserConversationSimulationDefaultConfiguration;

  /** Model or agent being evaluated. It receives turns from the simulated user during the conversation simulation. */
  target: FoundryEvaluationTarget;
}

/** Seed data-generation configuration for `SyntheticDataGenerationWithSimulationEvalRunDataSource`. The `generation_sources` are forwarded directly to the data generation endpoint to produce the seed test cases that are subsequently simulated. */
model SyntheticDataGenerationConfiguration {
  /** Number of seed test cases to generate. */
  test_case_count?: int32;

  /** Name of the dataset where the generated seed test cases are stored. When omitted, the service generates a name automatically. */
  output_test_case_dataset_name?: string;

  /** Seed generation sources (prompt, agent, or file) forwarded to the data generation endpoint. Multiple sources may be provided. */
  generation_sources: DataGenerationJobSource[];
}

/**
 * A data source that retrieves deployed interactions for continuous evaluation.
 *
 * See [evaluate deployed interactions](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/cloud-evaluation-deployed-interactions?tabs=response-id-python%2Cpython).
 */
model AzureAIResponsesEvalRunDataSource extends EvalRunDataSource {
  /** The type of data source, always `azure_ai_responses`. */
  type: "azure_ai_responses";

  /** Configuration for retrieving and preparing stored response history as evaluation input items. */
  item_generation_params: ResponseRetrievalItemGenerationParams;

  /** Maximum number of evaluation runs allowed per hour. */
  max_runs_hourly: int32;

  /** The event configuration name associated with this evaluation run. */
  event_configuration_id: string;
}

/**
 * A data source for evaluating model or agent target completions.
 *
 * See [evaluate conversations](https://learn.microsoft.com/en-us/azure/foundry/observability/how-to/cloud-evaluation-conversations?tabs=python).
 */
model TargetCompletionEvalRunDataSource extends EvalRunDataSource {
  /** The type of data source, always `azure_ai_target_completions`. */
  type: "azure_ai_target_completions";

  /** Input messages configuration. */
  input_messages?: OpenAI.CreateEvalCompletionsRunDataSourceInputMessagesItemReference;

  /** The source configuration for inline or file data. */
  #suppress "@azure-tools/typespec-autorest/union-unsupported" "This union is defined according to the Azure OpenAI API."
  #suppress "@azure-tools/typespec-azure-core/no-unnamed-types" "Auto-suppressed warnings non-applicable rules during import."
  source: OpenAI.EvalJsonlFileContentSource | OpenAI.EvalJsonlFileIdSource;

  /** The target configuration for the evaluation. */
  target: FoundryEvaluationTarget;

  /** The parameters for item generation. */
  item_generation_params?: ItemGenerationParams;
}
/** Represents a reference to an uploaded CSV file used as a source for evaluation data. */
model EvalCsvFileIdSource {
  /** The type of source, always `file_id`. */
  type: "file_id";

  /** The identifier of the uploaded CSV file. */
  id: string;
}

/**
 * A CSV data source for evaluation runs.
 *
