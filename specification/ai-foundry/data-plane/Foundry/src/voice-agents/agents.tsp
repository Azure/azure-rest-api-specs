import "@typespec/http";
import "@typespec/openapi";
import "@typespec/versioning";
import "@azure-tools/openai-typespec/models/realtime";
import "../common/servicepatterns.tsp";
import "../agents/models.tsp";
import "../openai/responses/models.tsp";

using TypeSpec.Http;
using TypeSpec.OpenAPI;
using TypeSpec.Versioning;

namespace Azure.AI.Projects;

// ============================================================================
// Voice agent definition and configuration models. Voice agents are a
// first-class `kind` on the shared `/agents` resource and reuse the standard
// agent lifecycle, versioning, identity, and SDK surface.
// ============================================================================

const VoiceAgentRequiredPreview = #{
  required_previews: #[AgentDefinitionOptInKeys.voice_agents_v1_preview],
};

// Keep the intermediate message discriminator model aligned with the preview metadata on the voice-item base and
// concrete persisted item models.
@@extension(
  OpenAI.RealtimeConversationItemMessage,
  "x-ms-foundry-meta",
  VoiceAgentRequiredPreview
);

@doc("Additional fields that a voice-agent session may include in service outputs.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentSessionIncludeOption {
  input_audio_transcription_logprobs: "item.input_audio_transcription.logprobs",
  input_audio_transcription_phrases: "item.input_audio_transcription.phrases",
  file_search_call_results: "file_search_call.results",
}

#suppress "@azure-tools/typespec-client-generator-core/use-union-hierarchy" "Pre-existing API contract; preserve the existing API and SDK union representation."
@doc("The maximum output-token count or the literal `inf`.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentMaxOutputTokens {
  count: int32,
  unlimited: "inf",
}

@doc("A condition that may trigger an interim response.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentInterimResponseTrigger {
  string,
  latency: "latency",
  tool: "tool",
}

@doc("Fields shared by interim-response configurations.")
@discriminator("type")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentInterimResponseConfig {
  @doc("The interim-response implementation.")
  type: string;

  @doc("Conditions that may trigger one interim response.")
  triggers?: VoiceAgentInterimResponseTrigger[] = #[
    VoiceAgentInterimResponseTrigger.latency
  ];

  #suppress "@azure-tools/typespec-azure-core/known-encoding" "The existing voice-agent wire contract requires integer-millisecond durations."
  @doc("The latency threshold in milliseconds.")
  @encode(DurationKnownEncoding.milliseconds, int32)
  latency_threshold_ms?: duration = duration.fromISO("PT2S");
}

@doc("A static interim response selected from configured text.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentStaticInterimResponseConfig
  extends VoiceAgentInterimResponseConfig {
  type: "static_interim_response";

  @doc("Candidate text values for the interim response.")
  texts?: string[];
}

@doc("An interim response generated by a language model.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLlmInterimResponseConfig
  extends VoiceAgentInterimResponseConfig {
  type: "llm_interim_response";

  @doc("The model used to generate interim responses.")
  `model`?: string;

  @doc("Optional instructions for generating interim responses.")
  instructions?: string;

  @doc("The maximum completion-token count for an interim response.")
  @minValue(1)
  max_completion_tokens?: int32 = 50;
}

@doc("""
  The voice agent definition. Its configuration (model, instructions, audio, tools, and optional avatar) drives a
  managed speech-to-speech experience. Establish realtime voice sessions through
  `GET /agents/{agent_name}/endpoint/protocols/voice`. Every create or update produces a new immutable version.
  """)
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentDefinition extends AgentDefinition {
  @doc("The kind discriminator for a voice agent definition. Always `voice`.")
  kind: AgentKind.voice;

  @doc("How the model backing this voice agent is served. Required with `model` for a model-backed voice agent and omitted when `conversation_engine` is provided. This is independent of the architecture (realtime or cascaded), which the service derives from the selected model.")
  model_type?: VoiceModelType;

  @doc("The model to use for this agent. Required with `model_type` for a model-backed voice agent and omitted when `conversation_engine` is provided. The model must support realtime or cascaded voice.")
  `model`?: string;

  @doc("The engine that owns conversation handling for this voice agent. Exactly one of this property and the model-backed configuration (`model_type` with `model`) must be provided. When this property is provided, `model_type`, `model`, `instructions`, `tools`, and `tool_choice` must be omitted, and `greeting.tool_choice` cannot be `required`, because the engine owns the conversation logic. The initial implementation supports a hosted-agent engine.")
  conversation_engine?: VoiceConversationEngine;

  @doc("A system (or developer) message inserted into the model's context. Supports template substitution via `structured_inputs`, rendered per session before the live session starts.")
  instructions?: string;

  @doc("Optional session-start greeting. Template mode speaks exact rendered text; LLM-generated mode asks the session model to author the opening response and may use configured tools.")
  greeting?: VoiceAgentGreetingConfig;

  @doc("""
    The audio configuration, including input and output formats, voice, turn detection, noise reduction, and
    transcription. These values are session defaults; a client may override supported fields when connecting.
    """)
  audio?: VoiceAgentAudioConfig;

  @doc("Optional background ambience and event cues, stored with the agent version and separate from the audio configuration. Currently rendered only for telephony calls, not browser WebRTC or direct voice WebSocket sessions. Omit this property to disable all auxiliary audio. Persisted conversation recordings do not include the soundscape mix.")
  soundscape?: VoiceAgentSoundscapeConfig;

  @doc("""
    The output modalities the agent produces. Defaults to `["audio"]`. `animation` and `avatar` are available
    when an avatar is configured.
    """)
  output_modalities?: VoiceOutputModality[] = #[VoiceOutputModality.audio];

  @doc("The maximum output-token count for one response.")
  max_output_tokens?: VoiceAgentMaxOutputTokens;

  @doc("Additional fields to include in service outputs.")
  include?: VoiceAgentSessionIncludeOption[];

  @doc("Interim-response settings for latency and tool execution.")
  interim_response?: VoiceAgentInterimResponseConfig;

  @doc("Optional avatar configuration. These values are session defaults and may be overridden when connecting.")
  avatar?: VoiceAgentAvatarConfig;

  @doc("""
    The tools the voice agent may use. Supported tool kinds are `function` (executed by the client), `mcp`,
    `system` (service-managed session controls), and `toolbox`. Server-side tools such as `web_search`,
    `azure_ai_search`, and `openapi` are provided through a toolbox rather than declared directly.
    """)
  tools?: VoiceAgentTool[];

  @doc("""
    How the model chooses tools for generated responses. `none` prevents tool calls, `auto` lets the model decide,
    `required` requires at least one tool call, and a specific function or MCP tool can be selected with an object.
    Defaults to `auto`.
    """)
  tool_choice?: VoiceAgentToolChoice = VoiceAgentToolChoice.auto;

  @doc("Whether the model may call multiple tools in parallel.")
  parallel_tool_calls?: boolean;

  @doc("Set of structured inputs that participate in prompt template substitution, rendered per session before the live session starts.")
  structured_inputs?: Record<StructuredInputDefinition>;

  @doc("Optional configuration for sibling Foundry text agents that this voice agent may consult as background specialists.")
  subagent_config?: VoiceAgentSubagentConfig;

  @doc("""
    Whether conversations with this agent are persisted. A single, all-or-nothing persistence switch that defaults to
    `false` (privacy-safe: off by default). When `true`, Foundry persists the full conversation — the transcript/event
    timeline and raw audio. When `false`, nothing is persisted and no conversation is surfaced. There is no separate
    audio-logging control; audio is persisted only as part of this switch. Latency/performance telemetry (e.g.
    time-to-first-audio, inter-token latency, interruption) is observability-only (customer trace / App Insights) and
    is not part of the persisted conversation content.
    """)
  store?: boolean = false;
}

@doc("Agent-owned background ambience and event cues. Each omitted track is disabled. The service rejects unknown fields; custom uploads, URLs, and inline audio are not supported.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSoundscapeConfig {
  @doc("Continuous background ambience that continues during caller and agent speech.")
  background?: VoiceAgentSoundscapeTrackConfig;

  @doc("A loop played while a non-call-control tool is pending and the agent is silent, after the configured delay.")
  working?: VoiceAgentSoundscapeWorkingTrackConfig;

  @doc("An interruptible cue played before the first agent speech.")
  opening?: VoiceAgentSoundscapeTrackConfig;

  @doc("A one-shot cue played after queued agent speech drains and before a committed call transfer.")
  transfer?: VoiceAgentSoundscapeTrackConfig;

  @doc("A one-shot cue played after queued agent speech drains and before a committed session end.")
  closing?: VoiceAgentSoundscapeTrackConfig;
}

@doc("A soundscape track with its own audio source and playback volume.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSoundscapeTrackConfig {
  @doc("The required audio source for this track.")
  source: VoiceAgentSoundscapeSourceConfig;

  @doc("Linear playback gain from 0 to 1, independent of agent speech volume. If omitted, the service defaults to 1. A value of 0 mutes this track.")
  @minValue(0)
  @maxValue(1)
  gain?: float64 = 1;
}

@doc("A working-loop track with a delay measured from the first pending non-call-control tool.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSoundscapeWorkingTrackConfig {
  ...VoiceAgentSoundscapeTrackConfig;

  #suppress "@azure-tools/typespec-azure-core/known-encoding" "The soundscape wire contract requires an integer-millisecond delay."
  @doc("The delay in milliseconds before working audio starts, from 0 to 10000. If omitted, the service defaults to 1000 milliseconds. This delays only working audio, not tool execution, and is valid only on the working track.")
  @encode(DurationKnownEncoding.milliseconds, int32)
  @minValue(duration.fromISO("PT0S"))
  @maxValue(duration.fromISO("PT10S"))
  delay_ms?: duration = duration.fromISO("PT1S");
}

@doc("A packaged sound selected from the service-managed catalogue. The service rejects unknown source fields and discriminator values.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSoundscapeSourceConfig {
  @doc("The audio source type. Always `built_in`.")
  type: "built_in";

  @doc("The name of the packaged sound. Only the listed built-in sounds are accepted.")
  name: VoiceAgentSoundscapeSound;
}

@doc("The packaged sounds accepted by a built-in soundscape source.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentSoundscapeSound {
  @doc("Quiet office ambience.")
  office: "office",

  @doc("Busy call-center ambience.")
  call_center: "call_center",

  @doc("Busy street ambience.")
  busy_street: "busy_street",

  @doc("Crowd conversation ambience.")
  people_talking: "people_talking",

  @doc("Street and metro-station ambience.")
  street_and_metro_station: "street_and_metro_station",

  @doc("The first notification tone.")
  ding1: "ding1",

  @doc("The second notification tone.")
  ding2: "ding2",
}

@doc("Configuration for sibling Foundry text agents that a voice agent may consult.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSubagentConfig {
  @doc("The sibling Foundry text agents, in the same project, that this voice agent may consult.")
  @minItems(1)
  subagents: VoiceAgentSubagent[];
}

@doc("A sibling Foundry text agent that a voice agent may consult as a background specialist.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSubagent {
  @doc("The name of the subagent. The subagent must be in the same project as the voice agent.")
  agent_name: string;

  @doc("The version of the subagent. When omitted, the active version is used.")
  agent_version?: string;

  @doc("A description of the subagent's capabilities, used by the voice agent to decide whether to forward a query.")
  agent_capabilities: string;

  @doc("Policy for acknowledging forwarded requests and filling gaps while waiting for this subagent's response.")
  response_policy?: VoiceAgentSubagentResponsePolicy;

  @doc("The wall-clock timeout, in seconds, for each invocation of this subagent. When omitted, the service timeout is used.")
  @encode(DurationKnownEncoding.seconds, int32)
  @minValue(duration.fromISO("PT5S"))
  @maxValue(duration.fromISO("PT20M"))
  invoke_timeout_seconds?: duration;
}

@doc("Policy for delivering responses while a voice agent waits for a subagent.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSubagentResponsePolicy {
  @doc("Whether the voice agent provides an immediate acknowledgement before forwarding a request to a subagent.")
  immediate_ack?: boolean;

  @doc("The number of seconds without subagent content or user input before the voice agent provides a gap-filling response.")
  @encode(DurationKnownEncoding.seconds, int32)
  @minValue(duration.fromISO("PT5S"))
  @maxValue(duration.fromISO("PT2M"))
  gap_filling_interval?: duration;

  @doc("Instructions used to generate the immediate acknowledgement.")
  ack_instructions?: string;

  @doc("Instructions used to generate gap-filling speech while waiting for progress.")
  gap_filling_instructions?: string;

  @doc("Whether progress updates are emitted incrementally instead of only when the subagent invocation completes. Defaults to `false`.")
  enable_delta_progress?: boolean = false;

  @doc("Instructions used to summarize streamed subagent progress for speech.")
  progress_instructions?: string;

  @doc("The minimum number of seconds between spoken progress updates.")
  @encode(DurationKnownEncoding.seconds, int32)
  @minValue(duration.fromISO("PT5S"))
  @maxValue(duration.fromISO("PT5M"))
  progress_update_interval?: duration;
}

@doc("Session-start greeting configuration for a voice agent.")
@discriminator("type")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentGreetingConfig {
  @doc("The greeting mode.")
  type: string;
}

@doc("A deterministic greeting rendered with the voice agent's structured inputs and synthesized without model-authored generation.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentTemplateGreetingConfig extends VoiceAgentGreetingConfig {
  type: "template";

  @doc("The Handlebars text template spoken at session start.")
  @minLength(1)
  text: string;
}

@doc("A greeting authored by the session model from a scoped opening-turn prompt.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLlmGeneratedGreetingConfig extends VoiceAgentGreetingConfig {
  type: "llm_generated";

  @doc("The Handlebars prompt that guides the opening turn.")
  @minLength(1)
  prompt: string;

  @doc("The tool-selection policy for the opening response. Defaults to `none`.")
  tool_choice?: VoiceAgentToolChoice = VoiceAgentToolChoice.none;
}

@doc("""
  How the model backing a voice agent is served. This is independent of the architecture (realtime or cascaded),
  which the service derives from the selected model.
  """)
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceModelType {
  string,

  @doc("The service hosts and manages the named model, for example `gpt-realtime`.")
  managed: "managed",

  @doc("The service uses the customer's own Foundry deployment named by `model`.")
  self_deployed: "self_deployed",
}

@doc("An engine that owns conversation handling for a voice agent.")
@discriminator("type")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceConversationEngine {
  @doc("The conversation engine type.")
  type: string;
}

@doc("A closed reference to the hosted text agent that owns conversation handling for a voice agent. The hosted agent is resolved within the same project and must declare `voice_conversation_engine` version `1.0.0`. Voice Live connects through the dedicated voice-conversation-engine endpoint using the existing Bridge Protocol 1.0 wire semantics; the Bridge message version is independent of the container protocol version and the Hosted Agents API version `v1`. Declaring `invocations_ws` is optional and does not substitute for `voice_conversation_engine`.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceHostedAgentConversationEngine extends VoiceConversationEngine {
  ...Record<never>;

  @doc("Selects a hosted Foundry agent as the conversation engine.")
  type: "hosted_agent";

  @doc("The non-empty DNS-like name of the target hosted text agent in the same project.")
  @minLength(1)
  @maxLength(63)
  @pattern("^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$")
  name: string;

  @doc("The target agent version. Omit this property to select the latest version when the voice session starts. When supplied, use a positive integer or `draft-{positive-unix-timestamp}` whose numeric component fits in a signed 64-bit integer.")
  @pattern("^(?:[1-9][0-9]{0,18}|draft-[1-9][0-9]{0,18})$")
  @maxLength(25)
  version?: string;
}

@doc("A tool usable by a voice agent.")
@discriminator("type")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentTool {
  @doc("The tool kind.")
  type: string;
}

@doc("A native function tool executed by the client.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentFunctionTool extends VoiceAgentTool {
  ...OmitProperties<OpenAI.RealtimeFunctionTool, "type" | "name">;
  type: "function";

  @doc("The function name.")
  @minLength(1)
  name: string;
}

#suppress "@azure-tools/typespec-autorest/union-unsupported" "Tool choice may be a mode, a forced function, or an MCP tool."
#suppress "@azure-tools/typespec-client-generator-core/use-union-hierarchy" "Pre-existing API contract; preserve the existing API and SDK union representation."
@doc("Tool-selection behavior for a voice agent.")
@oneOf
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentToolChoice {
  none: "none",
  auto: "auto",
  required: "required",
  function: OpenAI.ToolChoiceFunction,
  mcp: OpenAI.ToolChoiceMCP,
}

@doc("When a tool invocation creates a follow-up response. Additional values may be added over time.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentToolResponseScheduling {
  string,

  @doc("Do not create a follow-up response after the service-executed tool invocation completes.")
  silent: "silent",

  @doc("Create a follow-up response when the conversation is idle.")
  when_idle: "when_idle",

  @doc("Interrupt the active response and create a follow-up response.")
  interrupt: "interrupt",

  @doc("Create a follow-up response only when no response is active.")
  skip_if_busy: "skip_if_busy",
}

@doc("An MCP tool available to a voice agent. Server endpoints use `server_url`; connector and tunnel identifiers are not supported.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentMcpTool extends VoiceAgentTool {
  ...OmitProperties<OpenAI.MCPTool, "type" | "connector_id" | "tunnel_id">;
  type: "mcp";

  @doc("When the MCP invocation creates a follow-up response. Defaults to `when_idle`.")
  response_scheduling?: VoiceAgentToolResponseScheduling = VoiceAgentToolResponseScheduling.when_idle;
}

@doc("A service-managed control that acts on the active voice session without customer code or external authentication.")
@discriminator("name")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSystemTool extends VoiceAgentTool {
  @doc("The type of the tool. Always `system`.")
  type: "system";

  @doc("The service-managed control action. Known values are stable; additional values may be added over time.")
  name: VoiceAgentSystemToolName;

  @doc("Optional model-facing guidance. If omitted, the service uses the tool's built-in description; overriding it does not change the tool's parameter schema.")
  description?: string;
}

@doc("Ends the active conversation.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentEndConversationSystemTool extends VoiceAgentSystemTool {
  // Reject undeclared configuration fields; inherited fields remain allowed.
  ...Record<never>;

  @doc("The service-managed control action. Always `end_conversation`.")
  name: VoiceAgentSystemToolName.end_conversation;
}

@doc("Switches supported conversation language settings.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLanguageDetectionSystemTool extends VoiceAgentSystemTool {
  ...Record<never>;

  @doc("The service-managed control action. Always `language_detection`.")
  name: VoiceAgentSystemToolName.language_detection;
}

@doc("Retrieves the unchanged transcript of the last user audio turn.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentDigitRecognitionSystemTool extends VoiceAgentSystemTool {
  ...Record<never>;

  @doc("The service-managed control action. Always `digit_recognition`.")
  name: VoiceAgentSystemToolName.digit_recognition;
}

@doc("A built-in voice-session capability name. Known values are stable; additional values may be added over time.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentSystemToolName {
  string,

  @doc("Ends the active conversation.")
  end_conversation: "end_conversation",

  @doc("Switches supported conversation language settings.")
  language_detection: "language_detection",

  @doc("Retrieves the unchanged transcript of the last user audio turn.")
  digit_recognition: "digit_recognition",

  @doc("Requests a transfer to an explicitly configured logical target.")
  transfer: "transfer",

  @doc("Collects one complete SMS from an explicitly selected sender.")
  collect_sms: "collect_sms",

  @doc("Collects keypad digits on the current call.")
  collect_dtmf: "collect_dtmf",

  @doc("Sends literal or templated keypad digits.")
  send_dtmf: "send_dtmf",

  @doc("Sends a text message from the Agent's SMS-capable number.")
  send_sms: "send_sms",
}

@doc("Bare session variable name, such as `verification_code`, without a namespace or braces. Tool arguments reference it with `{{name}}`.")
@pattern("^[A-Za-z_][A-Za-z0-9_]*$")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
scalar VoiceAgentOutputReference extends string;

@doc("Collects one complete SMS from an explicitly selected sender.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentCollectSmsSystemTool extends VoiceAgentSystemTool {
  ...Record<never>;

  @doc("The service-managed control action. Always `collect_sms`.")
  name: VoiceAgentSystemToolName.collect_sms;

  @doc("Collection timeout, from 1 to 300 seconds, including receiver setup. If omitted, the service defaults to 60 seconds. Invocation timeout overrides it.")
  // TypeSpec 1.16 cannot version-project custom scalar values in min/max decorators.
  // Preserve the encoded-second bounds in OpenAPI while reusing the shared duration.
  @extension("minimum", 1)
  @extension("maximum", 300)
  timeout_seconds?: FoundryDurationSeconds = FoundryDurationSeconds.fromISO("PT60S");
}

@doc("Collects keypad digits on the current call.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentCollectDtmfSystemTool extends VoiceAgentSystemTool {
  ...Record<never>;

  @doc("The service-managed control action. Always `collect_dtmf`.")
  name: VoiceAgentSystemToolName.collect_dtmf;

  @doc("Collection timeout, from 1 to 300 seconds, including receiver setup. If omitted, the service defaults to 60 seconds. Invocation timeout overrides it.")
  @extension("minimum", 1)
  @extension("maximum", 300)
  timeout_seconds?: FoundryDurationSeconds = FoundryDurationSeconds.fromISO("PT60S");
}

@doc("Per-invocation transfer routing. Unsupported strategies are rejected before provider execution; schema membership does not imply support by every provider.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentTransferStrategy {
  string,

  @doc("Try destinations in configured order while the total budget remains.")
  sequential: "sequential",

  @doc("Randomize destination order for this invocation, then try each within the total budget.")
  random: "random",

  @doc("Ring destinations concurrently and select the first answer when the executor supports this strategy.")
  parallel: "parallel",
}

@doc("The configured transfer routing policy. The model selects a target name, not destinations or routing settings.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentTransferRouting {
  ...Record<never>;

  @doc("The routing strategy. Current native Telephony transfer supports ACS sequential and random routing only.")
  strategy: VoiceAgentTransferStrategy;

  @doc("Per-destination ring timeout in seconds, from 1 to 300. If omitted, the service defaults to 20 seconds. ACS allows at most 180 seconds.")
  @minValue(1)
  @maxValue(300)
  ring_timeout_seconds?: int32 = 20;

  @doc("Total routing timeout across destinations, from 1 to 300 seconds. If omitted, the service defaults to 45 seconds. Must be at least `ring_timeout_seconds`.")
  @minValue(1)
  @maxValue(300)
  total_timeout_seconds?: int32 = 45;
}

@doc("The supported address formats for a system-tool transfer destination.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentTransferDestinationType {
  @doc("An E.164 telephone number.")
  phone_number: "phone_number",

  @doc("Legacy input alias for phone_number. New configurations should use phone_number.")
  pstn: "pstn",

  @doc("A Microsoft Teams user or resource-account identifier.")
  teams: "teams",

  @doc("A SIP or SIPS URI.")
  sip: "sip",
}

@doc("The canonical system-tool transfer destination.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
@extension("anyOf", #[#{ required: #["type"] }, #{ required: #["kind"] }])
model VoiceAgentTransferDestination {
  ...Record<never>;

  @doc("The destination format: phone_number for an E.164 number, teams for a Teams identifier, or sip for a SIP URI.")
  type?: VoiceAgentTransferDestinationType;

  @doc("The concrete address. Phone numbers use E.164; Teams and SIP identifiers are validated against the selected provider's capabilities.")
  @minLength(1)
  value: string;
}

@doc("A configured logical transfer target. Only its name and description are model-visible; destinations and routing are executor settings.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentTransferTarget {
  ...Record<never>;

  @doc("The non-blank logical target name. Names must be unique after trimming within the transfer tool.")
  @minLength(1)
  @pattern("\\S")
  name: string;

  @doc("A description that helps the model select this target.")
  description?: string;

  @doc("The concrete destinations for this transfer target.")
  @minItems(1)
  destinations: VoiceAgentTransferDestination[];

  @doc("The trusted routing policy for this target.")
  routing: VoiceAgentTransferRouting;
}

@doc("Requests a transfer to an explicitly configured logical target.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentTransferSystemTool extends VoiceAgentSystemTool {
  ...Record<never>;

  @doc("The service-managed control action. Always `transfer`.")
  name: VoiceAgentSystemToolName.transfer;

  @doc("The non-empty set of logical targets that the model may select.")
  @minItems(1)
  targets: VoiceAgentTransferTarget[];
}

@doc("Sends literal or templated keypad digits.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentSendDtmfSystemTool extends VoiceAgentSystemTool {
  ...Record<never>;

  @doc("The service-managed control action. Always `send_dtmf`.")
  name: VoiceAgentSystemToolName.send_dtmf;

