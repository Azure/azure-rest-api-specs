import "@typespec/http";
import "@typespec/openapi";
import "@typespec/versioning";
import "@azure-tools/typespec-client-generator-core";
import "@azure-tools/openai-typespec/models/realtime";
import "@azure-tools/openai-typespec/models/live";
// OpenAI 1.29.0 Live models need the webhook-defined target_uri.
import "@azure-tools/openai-typespec/models/webhooks";
import "../common/servicepatterns.tsp";
import "../agents/models.tsp";
import "../openai/responses/models.tsp";
import "./handoff.tsp";

using TypeSpec.Http;
using TypeSpec.OpenAPI;
using TypeSpec.Versioning;
using Azure.ClientGenerator.Core;

namespace Azure.AI.Projects;

// ============================================================================
// Voice agent definition and configuration models. Voice agents are a
// first-class `kind` on the shared `/agents` resource and reuse the standard
// agent lifecycle, versioning, identity, and SDK surface.
// ============================================================================

const VoiceAgentRequiredPreview = #{
  required_previews: #[AgentDefinitionOptInKeys.voice_agents_v1_preview],
};

// Generally available voice-agent surfaces that accept a preview-only value or variant: GPT Live (`sub_protocol: live`),
// Handoff (inline subagents), and SIP telephony. Requests that use those values must send `VoiceAgents=V1Preview`.
const VoiceAgentConditionalPreview = #{
  conditional_previews: #[AgentDefinitionOptInKeys.voice_agents_v1_preview],
};

@doc("Additional fields that a voice-agent session may include in service outputs.")
union VoiceAgentSessionIncludeOption {
  input_audio_transcription_logprobs: "item.input_audio_transcription.logprobs",
  input_audio_transcription_phrases: "item.input_audio_transcription.phrases",
  file_search_call_results: "file_search_call.results",
}

#suppress "@azure-tools/typespec-client-generator-core/use-union-hierarchy" "Pre-existing API contract; preserve the existing API and SDK union representation."
@doc("The maximum output-token count or the literal `inf`.")
union VoiceAgentMaxOutputTokens {
  count: int32,
  unlimited: "inf",
}

@doc("A condition that may trigger an interim response.")
union VoiceAgentInterimResponseTrigger {
  string,
  latency: "latency",
  tool: "tool",
}

@doc("The interim-response implementations supported by a voice agent.")
union VoiceAgentInterimResponseType {
  string,

  @doc("Select a static interim response from configured text.")
  static_interim_response: "static_interim_response",

  @doc("Generate an interim response with a language model.")
  llm_interim_response: "llm_interim_response",
}

@doc("Fields shared by interim-response configurations.")
@discriminator("type")
model VoiceAgentInterimResponseConfig {
  @doc("The interim-response implementation.")
  type: VoiceAgentInterimResponseType;

  @doc("Conditions that may trigger one interim response.")
  triggers?: VoiceAgentInterimResponseTrigger[] = #[
    VoiceAgentInterimResponseTrigger.latency
  ];

  #suppress "@azure-tools/typespec-azure-core/known-encoding" "The existing voice-agent wire contract requires integer-millisecond durations."
  @doc("The latency threshold in milliseconds.")
  @encode(DurationKnownEncoding.milliseconds, int32)
  latency_threshold_ms?: duration = duration.fromISO("PT2S");
}

@doc("A static interim response selected from configured text.")
model VoiceAgentStaticInterimResponseConfig
  extends VoiceAgentInterimResponseConfig {
  type: VoiceAgentInterimResponseType.static_interim_response;

  @doc("Candidate text values for the interim response.")
  texts?: string[];
}

@doc("An interim response generated by a language model.")
model VoiceAgentLlmInterimResponseConfig
  extends VoiceAgentInterimResponseConfig {
  type: VoiceAgentInterimResponseType.llm_interim_response;

  @doc("The model used to generate interim responses.")
  `model`?: string;

  @doc("Optional instructions for generating interim responses.")
  instructions?: string;

  @doc("The maximum completion-token count for an interim response.")
  @minValue(1)
  max_completion_tokens?: int32 = 50;
}

@doc("""
  Shared voice-agent settings; protocol-specific fields remain flat on each subtype.
  Creates and updates produce immutable versions. Each version selects its own protocol, so a new version can switch between Realtime and Live.
  """)
@discriminator("sub_protocol")
model VoiceAgentBaseDefinition extends AgentDefinition {
  @doc("Always voice.")
  kind: AgentKind.voice;

  @doc("The voice protocol for this agent version. Null and unknown values are invalid.")
  sub_protocol: VoiceAgentSubProtocol;

  @doc("Frontend instructions, templated with structured_inputs. Backend instructions belong in delegation.responses.")
  instructions?: string;

  @doc("Template inputs for session instructions and supported greetings.")
  structured_inputs?: Record<StructuredInputDefinition>;

  @doc("Persists conversation content and audio in Foundry, not native Live recordings. Defaults to false.")
  store?: boolean = false;
}

@doc("Voice protocol; realtime includes cascaded models.")
@extension("x-ms-foundry-meta", VoiceAgentConditionalPreview)
union VoiceAgentSubProtocol {
  realtime: "realtime",
  live: "live",
}

@doc("""
  The voice agent definition. Its configuration (model, instructions, audio, tools, and optional avatar) drives a
  managed speech-to-speech experience. Establish realtime voice sessions through
  `GET /agents/{agent_name}/endpoint/protocols/voice`. Every create or update produces a new immutable version.
  """)
model VoiceAgentDefinition extends VoiceAgentBaseDefinition {
  @doc("Selects the Realtime protocol.")
  sub_protocol: VoiceAgentSubProtocol.realtime;

  @doc("How the model backing this voice agent is served. Required with `model` for a model-backed voice agent and omitted when `conversation_engine` is provided. This is independent of the architecture (realtime or cascaded), which the service derives from the selected model.")
  model_type?: VoiceModelType;

  @doc("The model to use for this agent. Required with `model_type` for a model-backed voice agent and omitted when `conversation_engine` is provided. The model must support realtime or cascaded voice.")
  `model`?: string;

  @doc("The engine that owns conversation handling for this voice agent. Exactly one of this property and the model-backed configuration (`model_type` with `model`) must be provided. When this property is provided, `model_type`, `model`, `instructions`, `tools`, and `tool_choice` must be omitted, and `greeting.tool_choice` cannot be `required`, because the engine owns the conversation logic. The initial implementation supports a hosted-agent engine.")
  conversation_engine?: VoiceConversationEngine;

  @doc("Optional session-start greeting. Template mode speaks exact rendered text; LLM-generated mode asks the session model to author the opening response and may use configured tools.")
  greeting?: VoiceAgentGreetingConfig;

  @doc("""
    The audio configuration, including input and output formats, voice, turn detection, noise reduction, and
    transcription. These values are session defaults; a client may override supported fields when connecting.
    """)
  audio?: VoiceAgentAudioConfig;

  @doc("Optional background ambience and event cues, stored with the agent version and separate from the audio configuration. Currently rendered only for telephony calls, not browser WebRTC or direct voice WebSocket sessions. Omit this property to disable all auxiliary audio. Persisted conversation recordings do not include the soundscape mix.")
  soundscape?: VoiceAgentSoundscapeConfig;

  @doc("""
    The output modalities the agent produces. Defaults to `["audio"]`. `animation` and `avatar` are available
    when an avatar is configured.
    """)
  output_modalities?: VoiceOutputModality[] = #[VoiceOutputModality.audio];

  @doc("The maximum output-token count for one response.")
  max_output_tokens?: VoiceAgentMaxOutputTokens;

  @doc("Additional fields to include in service outputs.")
  include?: VoiceAgentSessionIncludeOption[];

  @doc("Interim-response settings for latency and tool execution.")
  interim_response?: VoiceAgentInterimResponseConfig;

  @doc("Optional avatar configuration. These values are session defaults and may be overridden when connecting.")
  avatar?: VoiceAgentAvatarConfig;

  @doc("""
    The tools the voice agent may use. Supported tool kinds are `function` (executed by the client), `mcp`,
    `system` (service-managed session controls), and `toolbox`. Server-side tools such as `web_search`,
    `azure_ai_search`, and `openapi` are provided through a toolbox rather than declared directly.
    """)
  tools?: VoiceAgentTool[];

  @doc("""
    How the model chooses tools for generated responses. `none` prevents tool calls, `auto` lets the model decide,
    `required` requires at least one tool call, and a specific function or MCP tool can be selected with an object.
    Defaults to `auto`.
    """)
  tool_choice?: VoiceAgentToolChoice = VoiceAgentToolChoice.auto;

  @doc("Whether the model may call multiple tools in parallel.")
  parallel_tool_calls?: boolean;

  @doc("Optional subagent configuration. Set `subagent_type` to `delegate` for delegated background specialists or `inline` for inline voice subagents.")
  subagent_config?: VoiceAgentSubagentConfig;

  @doc("Optional post-call delivery configuration. After each session ends, the service notifies the configured destinations. Post-call delivery is in preview and requires `VoiceAgents=V1Preview`.")
  @extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
  post_call?: VoiceAgentPostCallConfig;
}

@doc("""
  The Live voice agent definition. Its configuration (model, instructions, audio, and delegation) drives a
  managed speech-to-speech experience using a Foundry GPT Live deployment. Establish Live voice sessions through
  `GET /agents/{agent_name}/endpoint/protocols/voice/live/sessions`. Every create or update produces a new immutable version.
  """)
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLiveDefinition extends VoiceAgentBaseDefinition {
  @doc("Selects the Live protocol.")
  sub_protocol: VoiceAgentSubProtocol.live;

  @doc("Uses a Foundry model deployment.")
  model_type: VoiceModelType.self_deployed;

  @doc("The GPT Live deployment name.")
  @minLength(1)
  `model`: string;

  @doc("Template-only startup greeting, rendered with session structured inputs. Foundry-only; not sent in native Live settings.")
  greeting?: VoiceAgentTemplateGreetingConfig;

  @doc("Startup audio formats and output voice.")
  audio?: OpenAI.LiveInitialSessionAudioParam;

  @doc("Delegation settings. Omit for client mode. responses.model is a backend deployment name in the Live resource, not a model catalog ID.")
  delegation?: VoiceAgentLiveDelegation;
}

// Generate the concrete models for SDK-specific subtype dispatch.
@@usage(VoiceAgentDefinition, Usage.input | Usage.output | Usage.json);
@@usage(VoiceAgentLiveDefinition, Usage.input | Usage.output | Usage.json);

@doc("Who handles delegated work for a Live voice agent.")
@discriminator("type")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLiveDelegation {
  @doc("The delegation owner.")
  type: VoiceAgentLiveDelegationType;
}

@doc("Supported owners of work delegated by a Live voice agent.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentLiveDelegationType {
  @doc("The application handles delegated work.")
  client: "client",

  @doc("A Responses backend handles delegated work.")
  responses: "responses",

  @doc("A prompt agent in the same project handles delegated work.")
  foundry_managed_agent: "foundry_managed_agent",
}

@doc("Delegates work to the application using native client delegation.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLiveClientDelegation extends VoiceAgentLiveDelegation {
  ...OmitProperties<OpenAI.LiveClientDelegationParam, "type">;
  type: VoiceAgentLiveDelegationType.client;
}

@doc("Delegates work to a Responses backend using native Responses settings.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLiveResponsesDelegation extends VoiceAgentLiveDelegation {
  ...OmitProperties<OpenAI.LiveResponsesDelegationParam, "type">;
  type: VoiceAgentLiveDelegationType.responses;
}

@doc("Delegates to a same-project prompt agent using native client delegation. Requires [thinking] and/or [commentary] output sections.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentLiveManagedAgentDelegation extends VoiceAgentLiveDelegation {
  @doc("Canonical delegation type; legacy managed_prompt_agent values are returned as foundry_managed_agent.")
  type: VoiceAgentLiveDelegationType.foundry_managed_agent;

  @doc("Name of a prompt agent in the same project.")
  agent_name: string;

  @doc("Agent version, pinned per connection. Omit to select the active version.")
  agent_version?: string;
}

@doc("Agent-owned background ambience and event cues. Each omitted track is disabled. The service rejects unknown fields; custom uploads, URLs, and inline audio are not supported.")
model VoiceAgentSoundscapeConfig {
  @doc("Continuous background ambience that continues during caller and agent speech.")
  background?: VoiceAgentSoundscapeTrackConfig;

  @doc("A loop played while a non-call-control tool is pending and the agent is silent, after the configured delay.")
  working?: VoiceAgentSoundscapeWorkingTrackConfig;

  @doc("An interruptible cue played before the first agent speech.")
  opening?: VoiceAgentSoundscapeTrackConfig;

  @doc("A one-shot cue played after queued agent speech drains and before a committed call transfer.")
  transfer?: VoiceAgentSoundscapeTrackConfig;

  @doc("A one-shot cue played after queued agent speech drains and before a committed session end.")
  closing?: VoiceAgentSoundscapeTrackConfig;
}

@doc("A soundscape track with its own audio source and playback volume.")
model VoiceAgentSoundscapeTrackConfig {
  @doc("The required audio source for this track.")
  source: VoiceAgentSoundscapeSourceConfig;

  @doc("Linear playback gain from 0 to 1, independent of agent speech volume. If omitted, the service defaults to 1. A value of 0 mutes this track.")
  @minValue(0)
  @maxValue(1)
  gain?: float64 = 1;
}

@doc("A working-loop track with a delay measured from the first pending non-call-control tool.")
model VoiceAgentSoundscapeWorkingTrackConfig {
  ...VoiceAgentSoundscapeTrackConfig;

  #suppress "@azure-tools/typespec-azure-core/known-encoding" "The soundscape wire contract requires an integer-millisecond delay."
  @doc("The delay in milliseconds before working audio starts, from 0 to 10000. If omitted, the service defaults to 1000 milliseconds. This delays only working audio, not tool execution, and is valid only on the working track.")
  @encode(DurationKnownEncoding.milliseconds, int32)
  @minValue(duration.fromISO("PT0S"))
  @maxValue(duration.fromISO("PT10S"))
  delay_ms?: duration = duration.fromISO("PT1S");
}

@doc("A packaged sound selected from the service-managed catalogue. The service rejects unknown source fields and discriminator values.")
model VoiceAgentSoundscapeSourceConfig {
  @doc("The audio source type. Always `built_in`.")
  type: "built_in";

  @doc("The name of the packaged sound. Only the listed built-in sounds are accepted.")
  name: VoiceAgentSoundscapeSound;
}

@doc("The packaged sounds accepted by a built-in soundscape source.")
union VoiceAgentSoundscapeSound {
  @doc("Quiet office ambience.")
  office: "office",

  @doc("Busy call-center ambience.")
  call_center: "call_center",

  @doc("Busy street ambience.")
  busy_street: "busy_street",

  @doc("Crowd conversation ambience.")
  people_talking: "people_talking",

  @doc("Street and metro-station ambience.")
  street_and_metro_station: "street_and_metro_station",

  @doc("The first notification tone.")
  ding1: "ding1",

  @doc("The second notification tone.")
  ding2: "ding2",
}

@doc("Post-call delivery configuration.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentPostCallConfig {
  @doc("The destinations to notify.")
  @minItems(1)
  @maxItems(10)
  destinations: VoiceAgentPostCallDestination[];

  @doc("Additional content to include in each delivery. The transcript is always delivered; add `audio` to also deliver a URL to the merged call recording.")
  include?: VoiceAgentPostCallIncludeOption[];
}

@doc("The type of a post-call destination.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentPostCallDestinationType {
  string,

  @doc("An Event Grid connection.")
  event_grid: "event_grid",

  @doc("A routine.")
  routine: "routine",
}

@doc("A post-call destination.")
@discriminator("type")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentPostCallDestination {
  @doc("The destination type.")
  type: VoiceAgentPostCallDestinationType;
}

@doc("An Event Grid connection that receives post-call events.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentEventGridPostCallDestination
  extends VoiceAgentPostCallDestination {
  @doc("The destination type. Always `event_grid`.")
  type: VoiceAgentPostCallDestinationType.event_grid;

  @doc("The name of the Event Grid connection.")
  @minLength(1)
  @example("post-call-events")
  connection_name: string;
}

@doc("A routine that is dispatched with the post-call event.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentRoutinePostCallDestination
  extends VoiceAgentPostCallDestination {
  @doc("The destination type. Always `routine`.")
  type: VoiceAgentPostCallDestinationType.routine;

  @doc("The name of the routine.")
  @minLength(1)
  @maxLength(128)
  @example("archive")
  name: string;
}

@doc("Content that can be included in a post-call delivery.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
union VoiceAgentPostCallIncludeOption {
  string,

  @doc("A URL to the merged call recording.")
  audio: "audio",
}

@doc("The subagent configuration mode. Additional modes may be added over time.")
@extension("x-ms-foundry-meta", VoiceAgentConditionalPreview)
union VoiceAgentSubagentType {
  string,

  @doc("Referenced Foundry agents invoked as delegated background specialists.")
  delegate: "delegate",

  @doc("Inline voice behaviors that may become active through Handoff.")
  inline: "inline",
}

@doc("""
  Configuration for delegated background specialists or inline voice subagents. For compatibility with existing
  delegate configurations, the service treats an omitted `subagent_type` as `delegate`.
  """)
@discriminator("subagent_type")
@extension("x-ms-foundry-meta", VoiceAgentConditionalPreview)
model VoiceAgentSubagentConfig {
  @doc("The subagent mode.")
  subagent_type: VoiceAgentSubagentType;
}

@doc("Configuration for referenced Foundry agents invoked as delegated background specialists.")
model VoiceAgentDelegateSubagentConfig extends VoiceAgentSubagentConfig {
  @doc("The subagent mode for delegated background specialists.")
  subagent_type: VoiceAgentSubagentType.delegate;

  @doc("The sibling Foundry text agents, in the same project, that this Voice Agent may consult.")
  @minItems(1)
  subagents: VoiceAgentSubagent[];
}

@doc("Configuration for inline voice subagents that may become active through Handoff.")
@extension("x-ms-foundry-meta", VoiceAgentRequiredPreview)
model VoiceAgentInlineSubagentConfig extends VoiceAgentSubagentConfig {
  @doc("The subagent mode for inline voice subagents.")
  subagent_type: VoiceAgentSubagentType.inline;

  @doc("""
    Inline voice subagents owned and versioned with the parent Voice Agent. `$entrypoint` must be first, followed
    by at least one specialist and at most 31 additional subagents. Each subagent declares its outgoing
    `handoff_conditions`; condition identifiers and the 128-condition limit apply across the entire Agent.
    """)
  @minItems(2)
  @maxItems(32)
  subagents: InlineVoiceSubagent[];

  @doc("Session-wide Handoff limits. Requires `$entrypoint` with at least one outgoing condition. When omitted, the service permits up to 16 completed and 16 attempted handoffs.")
  handoff_policy?: VoiceAgentHandoffPolicy;
}

@doc("A sibling Foundry text agent that a voice agent may consult as a background specialist.")
model VoiceAgentSubagent {
  @doc("The name of the subagent. The subagent must be in the same project as the voice agent.")
  agent_name: string;

  @doc("The version of the subagent. When omitted, the active version is used.")
  agent_version?: string;

  @doc("A description of the subagent's capabilities, used by the voice agent to decide whether to forward a query.")
  agent_capabilities: string;

  @doc("Policy for acknowledging forwarded requests and filling gaps while waiting for this subagent's response.")
  response_policy?: VoiceAgentSubagentResponsePolicy;

  @doc("The wall-clock timeout in seconds for each invocation of this subagent. When omitted, the service timeout is used.")
  @encode(DurationKnownEncoding.seconds, int32)
  @minValue(duration.fromISO("PT5S"))
  @maxValue(duration.fromISO("PT20M"))
  invoke_timeout_seconds?: duration;
}

@doc("Policy for delivering responses while a voice agent waits for a subagent.")
model VoiceAgentSubagentResponsePolicy {
  @doc("Whether the voice agent provides an immediate acknowledgement before forwarding a request to a subagent.")
  immediate_ack?: boolean;

  @doc("The number of seconds without subagent content or user input before the voice agent provides a gap-filling response.")
  @encode(DurationKnownEncoding.seconds, int32)
  @minValue(duration.fromISO("PT5S"))
  @maxValue(duration.fromISO("PT2M"))
  gap_filling_interval?: duration;

  @doc("Instructions used to generate the immediate acknowledgement.")
  ack_instructions?: string;

  @doc("Instructions used to generate gap-filling speech while waiting for progress.")
  gap_filling_instructions?: string;

  @doc("Whether progress updates are emitted incrementally instead of only when the subagent invocation completes. Defaults to `false`.")
  enable_delta_progress?: boolean = false;

  @doc("Instructions used to summarize streamed subagent progress for speech.")
  progress_instructions?: string;

  @doc("The minimum number of seconds between spoken progress updates.")
  @encode(DurationKnownEncoding.seconds, int32)
  @minValue(duration.fromISO("PT5S"))
  @maxValue(duration.fromISO("PT5M"))
  progress_update_interval?: duration;
}

@doc("The greeting modes supported by a voice agent.")
union VoiceAgentGreetingMode {
  string,

  @doc("Speak a deterministic greeting rendered from a text template.")
  template: "template",

  @doc("Generate the greeting with the session model from an opening-turn prompt.")
  llm_generated: "llm_generated",
}

@doc("Session-start greeting configuration for a voice agent.")
@discriminator("type")
model VoiceAgentGreetingConfig {
  @doc("The greeting mode.")
  type: VoiceAgentGreetingMode;
}

@doc("A deterministic greeting rendered with the voice agent's structured inputs and synthesized without model-authored generation.")
model VoiceAgentTemplateGreetingConfig extends VoiceAgentGreetingConfig {
  type: VoiceAgentGreetingMode.template;

  @doc("The Handlebars text template spoken at session start.")
  @minLength(1)
  text: string;
}

@doc("A greeting authored by the session model from a scoped opening-turn prompt.")
model VoiceAgentLlmGeneratedGreetingConfig extends VoiceAgentGreetingConfig {
  type: VoiceAgentGreetingMode.llm_generated;

  @doc("The Handlebars prompt that guides the opening turn.")
  @minLength(1)
  prompt: string;

  @doc("The tool-selection policy for the opening response. Defaults to `none`.")
  tool_choice?: VoiceAgentToolChoice = VoiceAgentToolChoice.none;
}

@doc("""
  How the model backing a voice agent is served. This is independent of the architecture (realtime or cascaded),
  which the service derives from the selected model.
  """)
union VoiceModelType {
  string,

  @doc("The service hosts and manages the named model, for example `gpt-realtime`.")
  managed: "managed",

  @doc("The service uses the customer's own Foundry deployment named by `model`.")
  self_deployed: "self_deployed",
}

@doc("The conversation engine types supported by a voice agent.")
union VoiceConversationEngineType {
  string,

  @doc("Use a hosted Foundry agent to handle the conversation.")
  hosted_agent: "hosted_agent",
}

@doc("An engine that owns conversation handling for a voice agent.")
@discriminator("type")
model VoiceConversationEngine {
  @doc("The conversation engine type.")
  type: VoiceConversationEngineType;
}

@doc("A closed reference to the hosted text agent that owns conversation handling for a voice agent. The hosted agent is resolved within the same project and must declare `voice_conversation_engine` version `1.0.0`. Voice Live connects through the dedicated voice-conversation-engine endpoint using the existing Bridge Protocol 1.0 wire semantics; the Bridge message version is independent of the container protocol version and the Hosted Agents API version `v1`. Declaring `invocations_ws` is optional and does not substitute for `voice_conversation_engine`.")
model VoiceHostedAgentConversationEngine extends VoiceConversationEngine {
  ...Record<never>;

  @doc("Selects a hosted Foundry agent as the conversation engine.")
  type: VoiceConversationEngineType.hosted_agent;

  @doc("The non-empty DNS-like name of the target hosted text agent in the same project.")
  @minLength(1)
  @maxLength(63)
  @pattern("^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$")
  name: string;

  @doc("The target agent version. Omit this property to select the latest version when the voice session starts. When supplied, use a positive integer or `draft-{positive-unix-timestamp}` whose numeric component fits in a signed 64-bit integer.")
  @pattern("^(?:[1-9][0-9]{0,18}|draft-[1-9][0-9]{0,18})$")
  @maxLength(25)
  version?: string;
}

@doc("The tool kinds supported by a voice agent.")
union VoiceAgentToolType {
  string,

  @doc("A native function tool executed by the client.")
  function: "function",

  @doc("A tool exposed by an MCP server.")
  mcp: "mcp",

  @doc("A service-managed control that acts on the active voice session.")
  system: "system",

  @doc("A reference to a Foundry toolbox.")
  toolbox: "toolbox",
}

@doc("A tool usable by a voice agent.")
@discriminator("type")
model VoiceAgentTool {
  @doc("The tool kind.")
  type: VoiceAgentToolType;
}

@doc("A native function tool executed by the client.")
model VoiceAgentFunctionTool extends VoiceAgentTool {
  ...OmitProperties<OpenAI.RealtimeFunctionTool, "type" | "name">;
  type: VoiceAgentToolType.function;

  @doc("The function name.")
  @minLength(1)
  name: string;
}

#suppress "@azure-tools/typespec-autorest/union-unsupported" "Tool choice may be a mode, a forced function, or an MCP tool."
#suppress "@azure-tools/typespec-client-generator-core/use-union-hierarchy" "Pre-existing API contract; preserve the existing API and SDK union representation."
@doc("Tool-selection behavior for a voice agent.")
@oneOf
union VoiceAgentToolChoice {
  none: "none",
  auto: "auto",
  required: "required",
  function: OpenAI.ToolChoiceFunction,
  mcp: OpenAI.ToolChoiceMCP,
}

@doc("When a tool invocation creates a follow-up response. Additional values may be added over time.")
union VoiceAgentToolResponseScheduling {
  string,

  @doc("Do not create a follow-up response after the service-executed tool invocation completes.")
  silent: "silent",

  @doc("Create a follow-up response when the conversation is idle.")
  when_idle: "when_idle",

  @doc("Interrupt the active response and create a follow-up response.")
  interrupt: "interrupt",

  @doc("Create a follow-up response only when no response is active.")
  skip_if_busy: "skip_if_busy",
}

@doc("An MCP tool available to a voice agent. Server endpoints use `server_url`; connector and tunnel identifiers are not supported.")
model VoiceAgentMcpTool extends VoiceAgentTool {
  ...OmitProperties<OpenAI.MCPTool, "type" | "connector_id" | "tunnel_id">;
  type: VoiceAgentToolType.mcp;

  @doc("When the MCP invocation creates a follow-up response. Defaults to `when_idle`.")
  response_scheduling?: VoiceAgentToolResponseScheduling = VoiceAgentToolResponseScheduling.when_idle;
}

@doc("A service-managed control that acts on the active voice session without customer code or external authentication.")
@discriminator("name")
model VoiceAgentSystemTool extends VoiceAgentTool {
  @doc("The type of the tool. Always `system`.")
  type: VoiceAgentToolType.system;

  @doc("The service-managed control action. Known values are stable; additional values may be added over time.")
  name: VoiceAgentSystemToolName;

  @doc("An optional description of the system tool.")
  description?: string;

  @doc("The execution timeout in seconds, from 1 to 300. If omitted, the service defaults to 60 seconds.")
  @extension("minimum", 1)
  @extension("maximum", 300)
  timeout_seconds?: FoundryDurationSeconds = FoundryDurationSeconds.fromISO("PT60S");
}

@doc("A service-managed control that ends the active conversation.")
model VoiceAgentEndConversationSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `end_conversation`.")
  name: VoiceAgentSystemToolName.end_conversation;
}

@doc("Switches supported conversation language settings.")
model VoiceAgentLanguageDetectionSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `language_detection`.")
  name: VoiceAgentSystemToolName.language_detection;
}

@doc("Retrieves the unchanged transcript of the last user audio turn.")
model VoiceAgentDigitRecognitionSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `digit_recognition`.")
  name: VoiceAgentSystemToolName.digit_recognition;
}

@doc("A service-managed voice-session control action. Known values are stable; additional values may be added over time.")
union VoiceAgentSystemToolName {
  string,

  @doc("Ends the active conversation.")
  end_conversation: "end_conversation",

  @doc("Switches supported conversation language settings.")
  language_detection: "language_detection",

  @doc("Retrieves the unchanged transcript of the last user audio turn.")
  digit_recognition: "digit_recognition",

  @doc("Requests a transfer to an explicitly configured logical target.")
  transfer: "transfer",

  @doc("Collects one complete SMS from an explicitly selected sender.")
  collect_sms: "collect_sms",

  @doc("Collects keypad digits on the current call.")
  collect_dtmf: "collect_dtmf",

  @doc("Sends literal or templated keypad digits.")
  send_dtmf: "send_dtmf",

  @doc("Sends a text message from the Agent's SMS-capable number.")
  send_sms: "send_sms",
}

@doc("Bare session variable name, such as `verification_code`, without a namespace or braces. Tool arguments reference it with `{{name}}`.")
@pattern("^[A-Za-z_][A-Za-z0-9_]*$")
scalar VoiceAgentOutputReference extends string;

@doc("Collects one complete SMS from an explicitly selected sender.")
model VoiceAgentCollectSmsSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `collect_sms`.")
  name: VoiceAgentSystemToolName.collect_sms;
}

@doc("Collects keypad digits on the current call.")
model VoiceAgentCollectDtmfSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `collect_dtmf`.")
  name: VoiceAgentSystemToolName.collect_dtmf;
}

@doc("Per-invocation transfer routing. Unsupported strategies are rejected before provider execution; schema membership does not imply support by every provider.")
union VoiceAgentTransferStrategy {
  string,

  @doc("Try destinations in configured order while the total budget remains.")
  sequential: "sequential",

  @doc("Randomize destination order for this invocation, then try each within the total budget.")
  random: "random",

  @doc("Ring destinations concurrently and select the first answer when the executor supports this strategy.")
  parallel: "parallel",
}

@doc("The configured transfer routing policy. The model selects a target name, not destinations or routing settings.")
model VoiceAgentTransferRouting {
  @doc("The routing strategy. Current native Telephony transfer supports ACS sequential and random routing only.")
  strategy: VoiceAgentTransferStrategy;

  @doc("The per-destination ring timeout in seconds, from 1 to 300. If omitted, the service defaults to 20 seconds. Must not exceed the tool's execution timeout. ACS allows at most 180 seconds.")
  @extension("minimum", 1)
  @extension("maximum", 300)
  ring_timeout_seconds?: FoundryDurationSeconds = FoundryDurationSeconds.fromISO("PT20S");
}

@doc("The supported address formats for a system-tool transfer destination.")
@extension("x-ms-foundry-meta", VoiceAgentConditionalPreview)
union VoiceAgentTransferDestinationType {
  @doc("An E.164 telephone number.")
  phone_number: "phone_number",

  @doc("A Microsoft Teams user or resource-account identifier.")
  teams: "teams",

  @doc("A SIP or SIPS URI. SIP is in preview and requires the `VoiceAgents=V1Preview` opt-in.")
  sip: "sip",
}

@doc("The canonical system-tool transfer destination.")
model VoiceAgentTransferDestination {
  @doc("The destination format: phone_number for an E.164 number, teams for a Teams identifier, or sip for a SIP URI.")
  type: VoiceAgentTransferDestinationType;

  @doc("The concrete address. Phone numbers use E.164; Teams and SIP identifiers are validated against the selected provider's capabilities.")
  @minLength(1)
  value: string;
}

@doc("A configured logical transfer target. Only its name and description are model-visible; destinations and routing are executor settings.")
model VoiceAgentTransferTarget {
  @doc("The non-blank logical target name. Names must be unique after trimming within the transfer tool.")
  @minLength(1)
  @pattern("\\S")
  name: string;

  @doc("A description that helps the model select this target.")
  description?: string;

  @doc("The concrete destinations for this transfer target.")
  @minItems(1)
  destinations: VoiceAgentTransferDestination[];

  @doc("The trusted routing policy for this target.")
  routing: VoiceAgentTransferRouting;
}

@doc("Requests a transfer to an explicitly configured logical target.")
model VoiceAgentTransferSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `transfer`.")
  name: VoiceAgentSystemToolName.transfer;

  @doc("Require a non-blank handoff summary in each model-generated transfer call. Defaults to false; does not guarantee delivery to the recipient.")
  require_handoff?: boolean = false;

  @doc("The non-empty set of logical targets that the model may select.")
  @minItems(1)
  targets: VoiceAgentTransferTarget[];
}

@doc("Sends literal or templated keypad digits.")
model VoiceAgentSendDtmfSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `send_dtmf`.")
  name: VoiceAgentSystemToolName.send_dtmf;
}

@doc("Sends a text message from the Agent's SMS-capable number.")
model VoiceAgentSendSmsSystemTool extends VoiceAgentSystemTool {
  @doc("The service-managed control action. Always `send_sms`.")
  name: VoiceAgentSystemToolName.send_sms;
}

@doc("A reference to a Foundry toolbox, which is a versioned bundle of tools executed through its MCP endpoint.")
model VoiceAgentToolboxTool extends VoiceAgentTool {
  @doc("The type of the tool. Always `toolbox`.")
  type: VoiceAgentToolType.toolbox;

  @doc("The name of the toolbox to attach.")
  toolbox_name: string;

  @doc("The immutable version of the toolbox to attach.")
  toolbox_version: string;

  @doc("When the toolbox invocation creates a follow-up response. Defaults to `when_idle`.")
  response_scheduling?: VoiceAgentToolResponseScheduling = VoiceAgentToolResponseScheduling.when_idle;
}

@doc("""
  The audio configuration for a voice agent. These values are session defaults and may be overridden when connecting.
  """)
model VoiceAgentAudioConfig {
  @doc("Input (microphone) audio configuration.")
  input?: VoiceAgentAudioInputConfig;

  @doc("Output (agent speech) audio configuration.")
  output?: VoiceAgentAudioOutputConfig;
}

@doc("Input audio configuration for a voice agent.")
model VoiceAgentAudioInputConfig {
  @doc("The input audio format.")
  format?: OpenAI.RealtimeAudioFormats;

  @doc("Input noise reduction. Set to null to disable.")
  noise_reduction?: VoiceAgentNoiseReduction | null;

  @doc("Turn (end-of-speech) detection. Server-side turn detection is enabled by default; set to null to disable it, in which case the client must trigger responses manually.")
  turn_detection?: VoiceAgentTurnDetectionConfig | null;

  @doc("Optional server-side echo cancellation settings.")
  echo_cancellation?: VoiceAgentEchoCancellation | null;

  @doc("Asynchronous input-audio transcription. Set to null to disable transcription.")
  transcription?: VoiceAgentInputTranscription | null;
}

@doc("The voice implementation. Additional values may be added over time.")
union VoiceType {
  string,

  @doc("An OpenAI voice.")
  openai: "openai",

  @doc("An Azure standard voice.")
  azure_standard: "azure-standard",

  @doc("An Azure custom voice.")
  azure_custom: "azure-custom",

  @doc("An Azure personal voice.")
  azure_personal: "azure-personal",

  @doc("A voice synchronized with an avatar.")
  avatar_voice_sync: "avatar-voice-sync",

  @doc("An Azure native realtime voice.")
  azure_realtime_native: "azure-realtime-native",
}

@doc("""
  Voice output configuration. Inline subagents use it directly as their voice override, and the session-level
  output audio configuration extends it.
  Provider-specific fields are selected by `voice_type`:
  - `openai`: `voice` and `speed`.
  - `azure-standard`: `voice`, `voice_locale`, `speed`, `voice_temperature`, `custom_lexicon_url`,
    `custom_text_normalization_url`, `prefer_locales`, `style`, `pitch`, and `volume`.
  - `azure-custom`: all `azure-standard` fields except `style`, plus `custom_voice_endpoint_id`.
  - `azure-personal`: all `azure-standard` fields except `style`, plus `personal_voice_model`.
  - `avatar-voice-sync`: all `azure-standard` fields except `voice` and `style`, plus `personal_voice_model`;
    the voice name is derived from the avatar.
  - `azure-realtime-native`: `voice` and `speed`.
  """)
model VoiceAgentVoiceConfig {
  @doc("The voice name or identifier. Applies to `openai`, `azure-standard`, `azure-custom`, `azure-personal`, and `azure-realtime-native`. It does not apply to `avatar-voice-sync`, which derives the voice name from the avatar.")
  voice?: string;

  @doc("The voice implementation.")
  voice_type?: VoiceType;

  @doc("The enforced BCP-47 output locale. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  voice_locale?: string;

  @doc("The numeric output speed multiplier. Applies to all known `voice_type` values and defaults to 1.")
  @minValue(0.25)
  @maxValue(1.5)
  speed?: float32 = 1;

  @doc("The voice variation temperature. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  @minValue(0)
  @maxValue(1)
  voice_temperature?: float32;

  @doc("The URL of a custom pronunciation lexicon. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  custom_lexicon_url?: url;

  @doc("The URL of a custom text-normalization configuration. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  custom_text_normalization_url?: url;

  @doc("Preferred BCP-47 locales for multilingual synthesis. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  prefer_locales?: string[];

  @doc("The voice speaking style. Applies only when `voice_type` is `azure-standard`.")
  style?: string;

  @doc("The voice pitch adjustment. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  pitch?: string;

  @doc("The voice volume adjustment. Applies to `azure-standard`, `azure-custom`, `azure-personal`, and `avatar-voice-sync`.")
  volume?: string;

  @doc("The Azure custom-voice deployment endpoint identifier. Applies only when `voice_type` is `azure-custom`.")
  custom_voice_endpoint_id?: string;

  @doc("The Azure personal or avatar voice model. Applies only when `voice_type` is `azure-personal` or `avatar-voice-sync`.")
  personal_voice_model?: string;
}

#suppress "@azure-tools/typespec-azure-core/composition-over-inheritance" "The session-level output audio configuration is a superset of the voice configuration used by inline subagents; inheritance keeps a single SDK type hierarchy."
@doc("""
  Output audio configuration for a voice agent. Extends the voice configuration with the session-level `format` and
  `output_audio_timestamp_types` settings, which apply to every voice type.
  """)
model VoiceAgentAudioOutputConfig extends VoiceAgentVoiceConfig {
  @doc("The output audio format. Applies to every `voice_type` and defaults to 24 kHz PCM.")
  format?: OpenAI.RealtimeAudioFormats;

  @doc("Timestamp kinds to include with output audio. Applies to every `voice_type`.")
  output_audio_timestamp_types?: VoiceAgentAudioTimestampType[];
}

@doc("An output-audio timestamp kind supported by a voice agent.")
union VoiceAgentAudioTimestampType {
  @doc("Word-level timestamps.")
  word: "word",
}

@doc("""
  Input audio noise reduction configuration. `azure_deep_noise_suppression_headset` and
  `azure_personal_noise_suppression` are modes for local voice activity detection that
  enhance detection audio without changing the audio used for recognition.
  """)
model VoiceAgentNoiseReduction {
  @doc("""
    The noise reduction mode. `azure_deep_noise_suppression_headset` provides
    headset-optimized noise suppression for local voice activity detection, optimized for
    low-sample-rate audio including 8 kHz telephony audio without changing recognition audio (not
    restricted to headset devices). `azure_personal_noise_suppression` starts with headset
    suppression for local voice activity detection and personalizes detection after automatic speaker
    enrollment while keeping recognition audio unchanged and keeping headset suppression active when
    personalization is unavailable.
    """)
  type: VoiceAgentNoiseReductionType;
}

@doc("""
  The input audio noise reduction mode.
  - `azure_deep_noise_suppression_headset`: Azure headset-optimized noise suppression for local voice activity detection. Optimized for low-sample-rate audio, including 8 kHz telephony audio. Enhances detection audio without changing the audio used for recognition. The mode is not restricted to headset devices.
  - `azure_personal_noise_suppression`: Azure personalized noise suppression for local voice activity detection. Starts with headset suppression and personalizes detection after automatic speaker enrollment. Recognition audio is unchanged; headset suppression remains active when personalization is unavailable.
  """)
union VoiceAgentNoiseReductionType {
  string,
  near_field: "near_field",
  far_field: "far_field",

  @doc("Azure deep noise suppression.")
  azure_deep_noise_suppression: "azure_deep_noise_suppression",

  @doc("Azure headset-optimized noise suppression for local voice activity detection. Optimized for low-sample-rate audio, including 8 kHz telephony audio. Enhances detection audio without changing the audio used for recognition. The mode is not restricted to headset devices.")
  azure_deep_noise_suppression_headset: "azure_deep_noise_suppression_headset",

  @doc("Azure personalized noise suppression for local voice activity detection. Starts with headset suppression and personalizes detection after automatic speaker enrollment. Recognition audio is unchanged; headset suppression remains active when personalization is unavailable.")
  azure_personal_noise_suppression: "azure_personal_noise_suppression",
}

@doc("The turn-detection strategy. Additional values may be added over time.")
union VoiceAgentTurnDetectionType {
  string,

  @doc("Server-side voice activity detection.")
  server_vad: "server_vad",

  @doc("Semantic voice activity detection.")
  semantic_vad: "semantic_vad",

  @doc("Azure semantic voice activity detection.")
  azure_semantic_vad: "azure_semantic_vad",

  @doc("English-optimized Azure semantic voice activity detection.")
  azure_semantic_vad_en: "azure_semantic_vad_en",

  @doc("Multilingual Azure semantic voice activity detection.")
  azure_semantic_vad_multilingual: "azure_semantic_vad_multilingual",
}

@doc("Turn-detection configuration for a voice agent.")
@discriminator("type")
model VoiceAgentTurnDetectionConfig {
  @doc("The turn-detection strategy.")
  type: VoiceAgentTurnDetectionType;

  @doc("Whether the input audio buffer is truncated automatically when speech stops.")
  auto_truncate?: boolean = false;
}

@doc("Server-side voice activity detection.")
model VoiceAgentServerVadTurnDetection extends VoiceAgentTurnDetectionConfig {
  ...OmitProperties<OpenAI.RealtimeTurnDetectionServerVad, "type">;
  type: VoiceAgentTurnDetectionType.server_vad;

  @doc("Minimum speech duration required to trigger detection, in milliseconds.")
  speech_duration_ms?: FoundryDurationMilliseconds;

  @doc("Semantic end-of-utterance detection configuration. Set to null to disable it.")
  end_of_utterance_detection?: VoiceAgentEndOfUtteranceDetection | null;
}

@doc("The semantic end-of-utterance detection model.")
union VoiceAgentEndOfUtteranceDetectionModel {
  string,

  @doc("The default semantic detection model.")
  semantic_detection_v1: "semantic_detection_v1",

  @doc("The English-optimized semantic detection model.")
  semantic_detection_v1_en: "semantic_detection_v1_en",

  @doc("The multilingual semantic detection model.")
  semantic_detection_v1_multilingual: "semantic_detection_v1_multilingual",

  @doc("The smart end-of-turn detection model.")
  smart_end_of_turn_detection: "smart_end_of_turn_detection",
}

@doc("The sensitivity threshold for semantic end-of-utterance detection.")
union VoiceAgentEndOfUtteranceThresholdLevel {
  string,

  @doc("The low sensitivity threshold.")
  low: "low",

  @doc("The medium sensitivity threshold.")
  medium: "medium",

  @doc("The high sensitivity threshold.")
  high: "high",

  @doc("The service-selected sensitivity threshold.")
  default: "default",
}

@doc("Semantic end-of-utterance detection configuration.")
model VoiceAgentEndOfUtteranceDetection {
  @doc("The semantic detection model.")
  `model`: VoiceAgentEndOfUtteranceDetectionModel;

  @doc("The sensitivity threshold.")
  threshold_level?: VoiceAgentEndOfUtteranceThresholdLevel;

  @doc("The detection timeout in milliseconds.")
  timeout_ms?: FoundryDurationMilliseconds;
}

/** Options shared by Azure semantic voice activity detection configurations. */
alias VoiceAgentAzureSemanticVadOptions = {
  @doc("Activation threshold for voice activity detection, from 0 to 1.")
  @minValue(0)
  @maxValue(1)
  threshold?: float32;

  @doc("Audio to include before detected speech, in milliseconds.")
  prefix_padding_ms?: FoundryDurationMilliseconds;

  @doc("Silence required to end speech detection, in milliseconds.")
  silence_duration_ms?: FoundryDurationMilliseconds;

  @doc("Maximum idle time before the detector ends the turn, in milliseconds.")
  idle_timeout_ms?: FoundryDurationMilliseconds;

  @doc("Semantic end-of-utterance detection configuration. Set to null to disable it.")
  end_of_utterance_detection?: VoiceAgentEndOfUtteranceDetection | null;

  @doc("Minimum speech duration required to trigger detection, in milliseconds.")
  speech_duration_ms?: FoundryDurationMilliseconds;

  @doc("Whether filler words are removed from transcription.")
  remove_filler_words?: boolean = false;

  @doc("Whether a response is created automatically when speech stops.")
  create_response?: boolean = true;

  @doc("Whether user speech may interrupt the agent's response.")
  interrupt_response?: boolean = true;
};

@doc("Azure semantic voice activity detection.")
model VoiceAgentAzureSemanticVadTurnDetection
  extends VoiceAgentTurnDetectionConfig {
  type: VoiceAgentTurnDetectionType.azure_semantic_vad;
  ...VoiceAgentAzureSemanticVadOptions;

  @doc("BCP-47 language codes used for speech detection.")
  languages?: string[];
}

@doc("English-optimized Azure semantic voice activity detection.")
model VoiceAgentAzureSemanticVadEnTurnDetection
  extends VoiceAgentTurnDetectionConfig {
  type: VoiceAgentTurnDetectionType.azure_semantic_vad_en;
  ...VoiceAgentAzureSemanticVadOptions;
}

@doc("Multilingual Azure semantic voice activity detection.")
model VoiceAgentAzureSemanticVadMultilingualTurnDetection
  extends VoiceAgentTurnDetectionConfig {
  type: VoiceAgentTurnDetectionType.azure_semantic_vad_multilingual;
  ...VoiceAgentAzureSemanticVadOptions;

  @doc("BCP-47 language codes used for speech detection.")
  languages?: string[];
}

@doc("OpenAI semantic VAD turn-detection settings.")
model VoiceAgentSemanticVadTurnDetection extends VoiceAgentTurnDetectionConfig {
  ...OmitProperties<OpenAI.RealtimeTurnDetectionSemanticVad, "type">;
  type: VoiceAgentTurnDetectionType.semantic_vad;
}

@doc("The source of reference audio used for echo cancellation.")
union VoiceAgentEchoCancellationReferenceSource {
  server: "server",
  client: "client",
}

@doc("Server-side echo cancellation settings for input audio.")
model VoiceAgentEchoCancellation {
  @doc("The echo cancellation implementation. Always `server_echo_cancellation`.")
  type: "server_echo_cancellation";

  @doc("Whether reference audio comes from server playback or a client-provided channel.")
  reference_source?: VoiceAgentEchoCancellationReferenceSource = VoiceAgentEchoCancellationReferenceSource.server;

  @doc("The number of input channels. Use two interleaved channels when `reference_source` is `client`.")
  @minValue(1)
  @maxValue(2)
  channels?: int32 = 1;
}

@doc("""
  The input-audio transcription model identifier. This is a model name, not a Foundry deployment name. Mirrors the transcription models supported by the managed
  voice backend, covering the OpenAI Realtime transcription models plus the Azure and MAI models.
  `azure-speech-streaming` is supported for cascaded text-model conversations only (not realtime speech-to-speech models), requires a nonempty `language` such as `en-US` (comma-separated locales are supported), and supports `custom_speech`, `phrase_list`, and `profanity_filter`.
  Additional values may be added over time.
  """)
union VoiceAgentInputTranscriptionModel {
  string,

  @doc("OpenAI Whisper.")
  whisper_1: "whisper-1",

  @doc("OpenAI GPT Realtime Whisper.")
  gpt_realtime_whisper: "gpt-realtime-whisper",

  @doc("OpenAI GPT-4o transcribe.")
  gpt_4o_transcribe: "gpt-4o-transcribe",

  @doc("OpenAI GPT-4o mini transcribe.")
  gpt_4o_mini_transcribe: "gpt-4o-mini-transcribe",

  @doc("OpenAI GPT-4o transcribe with speaker diarization.")
  gpt_4o_transcribe_diarize: "gpt-4o-transcribe-diarize",

  @doc("OpenAI GPT Transcribe.")
  gpt_transcribe: "gpt-transcribe",

  @doc("OpenAI GPT Live Transcribe.")
  gpt_live_transcribe: "gpt-live-transcribe",

  @doc("MAI transcription.")
  mai_transcribe: "mai-transcribe",

  @doc("Azure AI Speech to text.")
  azure_speech: "azure-speech",

  @doc("Azure AI Speech streaming transcription for cascaded text-model conversations only. Requires a nonempty `language`, such as `en-US`; comma-separated locales are supported. Supports `custom_speech`, `phrase_list`, and `profanity_filter`. Not supported with realtime speech-to-speech models.")
  azure_speech_streaming: "azure-speech-streaming",
}

@doc("The supported input-transcript profanity filtering modes.")
union VoiceAgentProfanityFilterMode {
  string,

  @doc("Masks recognized profanity in the transcript.")
  masked: "masked",

  @doc("Includes recognized profanity in the transcript, subject to mandatory service masking policies.")
  unfiltered: "unfiltered",

  @doc("Removes recognized profanity from the transcript.")
  removed: "removed",
}

@doc("""
  Settings for transcribing input audio, including the transcription model, Custom Speech deployments,
  and phrase hints.
  When `model` is `azure-speech-streaming`, transcription is supported for cascaded text-model
  conversations only (not realtime speech-to-speech models), requires a nonempty `language` such as
  `en-US` (comma-separated locales are supported), and supports `custom_speech`, `phrase_list`, and
  `profanity_filter`.
  """)
model VoiceAgentInputTranscription {
  @doc("""
    The language of the input audio. Supplying the input language in
    [ISO-639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) (e.g. `en`) format
    will improve accuracy and latency. Optional for other transcription models; required and must be
    nonempty when `model` is `azure-speech-streaming` (such as `en-US`; comma-separated locales are
    supported).
    """)
  language?: string;

  ...OmitProperties<OpenAI.AudioTranscription, "model" | "language">;

  @doc("The transcription model identifier. Configure customer custom speech deployments in `custom_speech`. `azure-speech-streaming` is for cascaded text-model conversations only (not realtime speech-to-speech models), requires a nonempty `language` such as `en-US` (comma-separated locales are supported), and supports `custom_speech`, `phrase_list`, and `profanity_filter`.")
  `model`: VoiceAgentInputTranscriptionModel;

  @doc("Optional customer custom speech deployment configuration, keyed by locale.")
  custom_speech?: Record<string>;

  @doc("Optional phrase hints that bias recognition toward domain terms.")
  phrase_list?: string[];

  @doc("""
    Controls how profanity is handled in input transcripts. Supported only with managed Azure Speech
    (`azure-speech` and `azure-speech-streaming`), including Custom Speech.
    Set this property before the session starts. If omitted, the transcription provider's default applies.
    You cannot change the mode during a session.
    Filtering affects transcript events and the text sent to cascaded models. It does not change input
    audio, voice activity detection, or assistant speech; audio-native models still receive the original
    audio. Mandatory service masking policies apply even when you select `unfiltered`.
    """)
  profanity_filter?: VoiceAgentProfanityFilterMode;
}

@doc("The avatar video resolution.")
model VoiceAgentAvatarVideoResolution {
  @minValue(1)
  width: int32;

  @minValue(1)
  height: int32;
}

@doc("The rectangular crop applied to avatar video.")
model VoiceAgentAvatarVideoCrop {
  @minItems(2)
  @maxItems(2)
  bottom_right: uint32[];

  @minItems(2)
  @maxItems(2)
  top_left: uint32[];
}

@doc("The avatar video background.")
model VoiceAgentAvatarVideoBackground {
  image_url?: url;
  color?: string;
}

@doc("Avatar video encoder and presentation settings.")
model VoiceAgentAvatarVideoParams {
  @doc("The target video bitrate in bits per second.")
  bitrate?: int32 = 2000000;

  crop?: VoiceAgentAvatarVideoCrop;
  resolution?: VoiceAgentAvatarVideoResolution;
  background?: VoiceAgentAvatarVideoBackground;

  @minValue(1)
  @maxValue(2000)
  gop_size?: int32 = 10;
}

@doc("Avatar placement and motion settings.")
model VoiceAgentAvatarScene {
  @minValueExclusive(0)
  zoom?: float32 = 1;

  @minValue(-1)
  @maxValue(1)
  position_x?: float32 = 0;

  @minValue(-1)
  @maxValue(1)
  position_y?: float32 = 0;

  @minValue(-3.141592653589793)
  @maxValue(3.141592653589793)
  rotation_x?: float32 = 0;

  @minValue(-3.141592653589793)
  @maxValue(3.141592653589793)
  rotation_y?: float32 = 0;

  @minValue(-3.141592653589793)
  @maxValue(3.141592653589793)
  rotation_z?: float32 = 0;

  @minValueExclusive(0)
  @maxValue(1)
  amplitude?: float32 = 1;
}

@doc("""
  Avatar configuration for a voice agent. These values are session defaults and may be overridden when connecting.
  """)
model VoiceAgentAvatarConfig {
  @doc("The avatar type.")
  type: VoiceAgentAvatarType;

  @doc("The avatar character identifier, e.g. 'lisa'.")
  character: string;

  @doc("The avatar style, e.g. 'casual-sitting'.")
  style?: string;

