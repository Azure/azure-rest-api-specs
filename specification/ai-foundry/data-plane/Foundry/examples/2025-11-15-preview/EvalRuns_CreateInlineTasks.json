{
  "title": "Run a fully inline suite with tasks supplied in the request",
  "operationId": "EvalRuns_create",
  "parameters": {
    "api-version": "2025-11-15-preview",
    "Foundry-Features": "Evaluations=V1Preview",
    "body": {
      "inputs": {
        "inline_suite": {
          "harness_task_set": {
            "tasks": [
              {
                "id": "covered-water-damage",
                "name": "Covered water damage",
                "inputs": {
                  "text": "Review claim 12345 and cite the applicable policy."
                },
                "expected": {
                  "decision": "approved"
                }
              }
            ]
          },
          "graders": [
            {
              "name": "decision_check",
              "type": "deterministic",
              "check": {
                "field": "outputs.text",
                "operator": "contains",
                "value_from": "inputs.expected.decision"
              }
            }
          ],
          "scoring": {
            "aggregation": "all_pass"
          },
          "harness_config": {
            "type": "foundry_agent",
            "agent": {
              "name": "claims-agent",
              "version": "7"
            }
          },
          "execution_config": {
            "type": "harness_invocation"
          }
        }
      }
    }
  },
