{
  "title": "Publish an EvaluationJob version",
  "operationId": "EvaluationJobs_createVersion",
  "parameters": {
    "api-version": "2025-11-15-preview",
    "Foundry-Features": "Evaluations=V1Preview",
    "name": "claims-agent-regression",
    "Operation-Id": "claims-job-v1",
    "body": {
      "description": "Claims decision regression evaluation.",
      "metadata": {
        "team": "claims"
      },
      "dataset": {
        "name": "claims-response-evaluation",
        "version": "1.0"
      },
      "target": {
        "type": "foundry_agent",
        "name": "claims-agent",
        "version": "2"
      },
      "graders": [
        {
          "name": "answer-matches",
          "type": "exact_match",
