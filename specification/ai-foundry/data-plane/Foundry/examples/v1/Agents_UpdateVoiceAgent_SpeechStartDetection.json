{
  "title": "Agents_UpdateVoiceAgent_SpeechStartDetection",
  "operationId": "Agents_updateAgent_Agents_updateAgentFromCode",
  "parameters": {
    "api-version": "v1",
    "Foundry-Features": "VoiceAgents=V1Preview",
    "agent_name": "support-dynamic-vad-agent",
    "description": "Let a turn-taking classifier decide whether the caller is taking the turn, keeping the word count as its fallback.",
    "definition": {
      "kind": "voice",
      "model_type": "managed",
      "model": "gpt-4.1",
      "instructions": "Help callers with their support requests.",
      "audio": {
        "input": {
          "noise_reduction": {
            "type": "azure_deep_noise_suppression"
          },
          "turn_detection": {
            "type": "azure_semantic_vad",
            "threshold": 0.5,
            "silence_duration_ms": 500,
            "interrupt_response": true,
            "speech_start_detection": {
              "while_assistant_speaking": {
                "num_words": 2,
                "interruption_phrases": [
                  "stop",
                  "wait"
                ],
                "turn_taking_classifier": {
                  "threshold": 0.6,
                  "criteria": {
                    "not_turn": "Thanking the agent, or confirming that the caller is still listening, is not a turn."
                  }
                }
              },
              "while_assistant_not_speaking": {
                "num_words": 1,
                "turn_taking_classifier": {
                  "threshold": 0.5
                }
              }
            }
          },
          "transcription": {
            "model": "azure-speech-streaming",
            "language": "en-US"
          }
        },
        "output": {
          "voice": "en-US-AvaMultilingualNeural",
          "voice_type": "azure-standard",
          "voice_locale": "en-US"
        }
      }
    }
  },
  "responses": {
    "200": {
      "body": {
        "object": "agent",
        "id": "agent_support_dynamic_vad",
        "name": "support-dynamic-vad-agent",
        "state": "enabled",
        "configuration_state": "enabled",
        "versions": {
          "latest": {
            "metadata": null,
            "object": "agent.version",
