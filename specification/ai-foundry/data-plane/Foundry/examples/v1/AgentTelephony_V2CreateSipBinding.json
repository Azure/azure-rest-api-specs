{
  "title": "Create a SIP binding (VoiceAgents V2 preview)",
  "operationId": "AgentTelephony_createTelephonyBinding",
  "parameters": {
    "api-version": "v1",
    "Foundry-Features": "VoiceAgents=V2Preview",
    "agent_name": "support-agent",
    "body": {
      "provider": "sip",
      "connection_name": "sip-support-connection",
      "phone_number": "+14255550100",
      "label": "Customer support SIP",
      "allowed_calling_numbers": [
        "+14255550123",
        "^\\+1425[0-9]{7}$"
      ]
    }
  },
  "responses": {
    "201": {
      "headers": {
        "ETag": "\"binding-etag-sip-1\""
      },
      "body": {
        "id": "binding_support_sip",
        "provider": "sip",
        "connection_name": "sip-support-connection",
        "phone_number": "+14255550100",
        "label": "Customer support SIP",
        "incoming_call_url": "sip:support-agent@voice.contoso.com",
        "allowed_calling_numbers": [
          "+14255550123",
          "^\\+1425[0-9]{7}$"
        ]
      }
    }
  }
}
