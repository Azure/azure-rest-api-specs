{
  "title": "Agents_UpdateVoiceAgent_ServerVad",
  "operationId": "Agents_updateAgent_Agents_updateAgentFromCode",
  "parameters": {
    "api-version": "v1",
    "Foundry-Features": "VoiceAgents=V1Preview",
    "agent_name": "server-vad-agent",
    "description": "Creates a new agent version with personalized voice activity detection and Azure Speech streaming transcription.",
    "definition": {
      "kind": "voice",
      "model_type": "managed",
      "model": "gpt-4.1",
      "post_call": {
        "destinations": [
          {
            "type": "routine",
            "name": "archive"
          },
          {
            "type": "routine",
            "name": "analysis"
          }
        ]
      },
      "audio": {
        "input": {
          "noise_reduction": {
            "type": "azure_personal_noise_suppression"
          },
          "turn_detection": {
            "type": "server_vad",
            "threshold": 0.6,
            "prefix_padding_ms": 250,
            "silence_duration_ms": 450
          },
          "transcription": {
            "model": "azure-speech-streaming",
            "language": "en-US",
            "profanity_filter": "masked"
          }
        },
        "output": {
          "voice": "en-US-AvaMultilingualNeural",
          "voice_type": "azure-standard",
          "voice_locale": "en-US"
        }
      }
    }
  },
  "responses": {
    "200": {
      "body": {
        "object": "agent",
        "id": "agent_server_vad",
        "name": "server-vad-agent",
        "state": "enabled",
        "versions": {
          "latest": {
            "metadata": null,
            "object": "agent.version",
