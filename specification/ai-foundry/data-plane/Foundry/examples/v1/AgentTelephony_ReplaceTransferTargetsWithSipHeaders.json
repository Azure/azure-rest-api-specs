{
  "title": "Replace telephony transfer targets with SIP headers",
  "operationId": "AgentTelephony_replaceTelephonyTransferTargets",
  "parameters": {
    "api-version": "v1",
    "agent_name": "support-agent",
    "If-Match": "\"targets-etag-1\"",
    "transfer_targets": [
      {
        "name": "nurse_queue",
        "description": "Transfer when the caller needs a nurse; return the call to the contact center queue.",
        "destination": {
          "value": "sip:nurse-queue@acd.contoso.example",
          "type": "sip"
        },
        "sip_headers": [
          {
            "name": "X-Original-Call-Id",
            "value": "{{@system.sip_call_id}}"
          },
          {
            "name": "User-to-User",
            "value": "4e75727365;encoding=hex"
          }
        ]
      }
    ]
  },
  "responses": {
    "200": {
      "headers": {
        "ETag": "\"targets-etag-2\""
      },
      "body": {
        "transfer_targets": [
          {
            "name": "nurse_queue",
            "description": "Transfer when the caller needs a nurse; return the call to the contact center queue.",
            "destination": {
              "value": "sip:nurse-queue@acd.contoso.example",
              "type": "sip"
            },
            "sip_headers": [
              {
                "name": "X-Original-Call-Id",
                "value": "{{@system.sip_call_id}}"
              },
              {
                "name": "User-to-User",
                "value": "4e75727365;encoding=hex"
              }
            ]
          }
        ]
      }
    }
  }
}
