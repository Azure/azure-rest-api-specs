{
  "title": "Create a Twilio binding",
  "operationId": "AgentTelephony_createTelephonyBinding",
  "parameters": {
    "api-version": "v1",
    "Foundry-Features": "VoiceAgents=V1Preview",
    "agent_name": "support-agent",
    "body": {
      "provider": "twilio",
      "connection": "twilio-support-connection",
      "phone_number": "+14255550123",
      "label": "Customer support"
    }
  },
  "responses": {
    "201": {
      "headers": {
        "ETag": "\"binding-etag-2\""
      },
      "body": {
        "id": "binding_support_twilio",
        "provider": "twilio",
        "connection": "twilio-support-connection",
        "phone_number": "+14255550123",
        "label": "Customer support",
        "status": "active",
        "incoming_call_url": "https://contoso.services.ai.azure.com/agents/support-agent/endpoint/protocols/voice/telephony/twilio/callbacks/incoming_call"
      }
    }
  }
}
