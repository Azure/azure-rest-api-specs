{
  "title": "Agents_CreateVoiceAgent_ServerVad",
  "operationId": "Agents_createAgent_Agents_createAgentFromCode",
  "parameters": {
    "api-version": "v1",
    "Foundry-Features": "VoiceAgents=V1Preview",
    "name": "server-vad-agent",
    "description": "A voice agent that uses server-side voice activity detection.",
    "definition": {
      "kind": "voice",
      "model_type": "managed",
      "model": "gpt-realtime",
      "post_call": {
        "destinations": [
          {
            "type": "event_grid",
            "connection_name": "post-call-events"
          },
          {
            "type": "routine",
            "name": "archive"
          },
          {
            "type": "routine",
            "name": "analysis"
          }
        ],
        "include": {
          "transcript": true,
          "audio": false
        }
      },
      "audio": {
        "input": {
          "turn_detection": {
            "type": "server_vad",
            "threshold": 0.5,
            "prefix_padding_ms": 300,
            "silence_duration_ms": 500
          },
          "transcription": {
            "model": "gpt-realtime-whisper"
          }
        },
        "output": {
          "voice": "alloy",
          "voice_type": "azure-standard",
          "voice_locale": "en-US"
        }
      }
    }
  },
  "responses": {
