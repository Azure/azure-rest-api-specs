        "nextLink": "https://management.azure.com/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg1/providers/Microsoft.ContainerService/fleets/fleet1/listMemberCredentials?api-version=2026-11-01-preview&$filter=name%20eq%20'member-1'%20or%20name%20eq%20'member-2'&$top=100&$skipToken=opaque-token"
