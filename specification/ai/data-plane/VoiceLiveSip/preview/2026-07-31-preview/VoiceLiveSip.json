    "/voice-agent/realtime/sip/calls/{call_id}/refer": {
      "post": {
        "operationId": "Calls_Refer",
        "summary": "Transfer a SIP call (blind transfer)",
        "description": "Starts a blind transfer (REFER) of an active SIP call to another SIP target.",
