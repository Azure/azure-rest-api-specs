        }
      },
      "required": [
        "target_uri"
      ]
    },
    "SipReferCallResult": {
      "type": "object",
      "description": "The result of starting a blind transfer (REFER) of a SIP call.",
      "properties": {
        "call_id": {
          "type": "string",
