          "items": {
            "type": "string"
          }
        },
        "support_info": {
          "$ref": "#/definitions/SipWebhookSupportInfo",
          "description": "The optional support metadata for the webhook."
        }
      },
      "required": [
        "url"
      ]
    },
    "SipErrorResponse": {
      "type": "object",
      "description": "An error response returned by a Voice Live SIP control-plane operation.",
      "properties": {
        "type": {
          "type": "string",
          "description": "A URI reference identifying the problem type, for example `https://aka.ms/voicelive/sip/errors/call_not_found`."
        },
        "title": {
          "type": "string",
          "description": "A short, human-readable summary of the problem type."
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "description": "The HTTP status code generated for this occurrence of the problem."
        },
        "detail": {
          "type": "string",
          "description": "A human-readable explanation specific to this occurrence of the problem."
        },
        "instance": {
          "type": "string",
          "description": "A URI reference identifying the specific occurrence of the problem (typically the request path)."
        },
        "code": {
          "type": "string",
          "description": "A machine-readable error code, for example `call_not_found` or `invalid_request`."
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether retrying the request may succeed."
        },
        "trace_id": {
          "type": "string",
          "description": "The request correlation identifier, echoed for support diagnostics."
        },
        "sub_code": {
          "type": "string",
          "description": "An optional finer-grained error sub-code."
        },
        "call_id": {
          "type": "string",
          "description": "The SIP call identifier the error relates to, when applicable."
        },
        "state": {
          "type": "string",
          "description": "The SIP call state at the time of the error, when applicable."
        },
        "errors": {
          "type": "object",
          "description": "Per-field validation messages, present on `400` validation errors.",
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        }
      }
    },
