    "/voice-agent/realtime/sip/calls/{call_id}/accept": {
      "post": {
        "operationId": "Calls_Accept",
        "summary": "Accept an inbound SIP call",
        "description": "Accepts an inbound SIP call and starts the Voice Live agent session.",
        "parameters": [
          {
            "$ref": "#/parameters/ApiVersionParameter"
          },
          {
            "name": "call_id",
            "in": "path",
            "description": "The route-bound SIP call identifier.",
            "required": true,
            "type": "string"
          },
          {
            "name": "configuration",
            "in": "body",
            "description": "The Voice Live agent configuration applied to the accepted call.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SipAcceptCallRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "schema": {
              "$ref": "#/definitions/SipAcceptCallResult"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/SipErrorResponse"
            }
          }
        },
        "x-ms-examples": {
          "Accept an inbound SIP call": {
            "$ref": "./examples/Calls_Accept.json"
          }
        }
      }
    },
