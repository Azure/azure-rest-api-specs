  "swagger": "2.0",
  "info": {
    "title": "VoiceLiveSip",
    "version": "2026-07-31-preview",
    "description": "The Voice Live SIP control-plane API. This HTTP data-plane surface manages inbound SIP call\ncontrol (accept, reject, transfer, hangup), webhook registrations for SIP call lifecycle events,\nand resource-level SIP configuration. Real-time media and the `realtime.call.*` call lifecycle\nevents are delivered over the separate WebSocket-based `VoiceLive` data-plane contract.",
    "x-typespec-generated": [
      {
        "emitter": "@azure-tools/typespec-autorest"
      }
    ]
  },
  "schemes": [
    "https"
  ],
