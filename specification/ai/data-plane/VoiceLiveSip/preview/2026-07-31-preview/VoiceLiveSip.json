  "definitions": {
    "SipAcceptCallRequest": {
      "type": "object",
      "description": "The request body for accepting an inbound SIP call. The body is an open Voice Live agent\nconfiguration object (the same shape accepted by the realtime `session.update` event); all\nproperties are passed through to the accepted call's Voice Live session.",
      "additionalProperties": {}
    },
    "SipAcceptCallResult": {
      "type": "object",
      "description": "The result of accepting an inbound SIP call.",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The accepted SIP call identifier."
        },
        "state": {
          "$ref": "#/definitions/SipCallState",
          "description": "The current call state."
        },
        "voice_live_session_id": {
          "type": "string",
          "description": "The Voice Live session identifier, present once runtime setup has created one."
        }
      },
      "required": [
        "call_id",
        "state"
      ]
    },
    "SipCallIdentity": {
      "type": "object",
      "description": "The APIM-authenticated resource identity captured for downstream SIP calls.",
      "properties": {
        "internal_id": {
          "type": "string",
          "description": "The resource internal identifier (32-character hex GUID)."
        },
        "resource_id": {
          "type": "string",
          "description": "The full ARM resource identifier."
        },
        "subscription_id": {
          "type": "string",
          "description": "The Azure subscription identifier."
        },
        "tenant_id": {
          "type": "string",
          "description": "The Azure tenant identifier."
        },
        "product_id": {
          "type": "string",
          "description": "The optional APIM product identifier associated with the call."
        }
      },
      "required": [
        "internal_id",
        "resource_id",
        "subscription_id",
        "tenant_id"
      ]
    },
    "SipCallState": {
      "type": "string",
      "description": "The lifecycle state of a SIP call.",
      "enum": [
        "WaitingForCustomer",
        "Accepting",
        "Accepted",
        "Connected",
        "Rejecting",
        "Transferring",
        "Terminating",
        "Disconnected",
        "Failed",
        "Expired"
      ],
      "x-ms-enum": {
        "name": "SipCallState",
        "modelAsString": true,
        "values": [
          {
            "name": "waiting_for_customer",
            "value": "WaitingForCustomer",
            "description": "The inbound INVITE has arrived and the call is awaiting a customer decision."
          },
          {
            "name": "accepting",
            "value": "Accepting",
            "description": "The customer accepted the call and runtime setup is in progress."
          },
          {
            "name": "accepted",
            "value": "Accepted",
            "description": "The SDP answer has been received but the call is not fully connected yet."
          },
          {
            "name": "connected",
            "value": "Connected",
            "description": "The Voice Live runtime is configured and the call is active."
          },
          {
            "name": "rejecting",
            "value": "Rejecting",
            "description": "The customer rejected a waiting call and rejection is in progress."
          },
          {
            "name": "transferring",
            "value": "Transferring",
            "description": "A blind transfer is in progress."
          },
          {
            "name": "terminating",
            "value": "Terminating",
            "description": "Call termination and cleanup are in progress."
          },
          {
            "name": "disconnected",
            "value": "Disconnected",
            "description": "The call ended normally or by an explicit hangup, reject, or transfer completion."
          },
          {
            "name": "failed",
            "value": "Failed",
            "description": "The call failed because setup or runtime control could not complete."
          },
          {
            "name": "expired",
            "value": "Expired",
            "description": "The waiting call expired before the customer made a decision."
          }
        ]
      }
    },
    "SipCallTerminalReason": {
      "type": "string",
      "description": "The terminal reason recorded when a SIP call leaves the active state machine.",
      "enum": [
        "Rejected",
        "CustomerHangup",
        "SipProxyTerminate",
        "DecisionTimeout",
        "SetupFailure",
        "TransferSucceeded",
        "RuntimeError"
      ],
      "x-ms-enum": {
        "name": "SipCallTerminalReason",
        "modelAsString": true,
        "values": [
          {
            "name": "rejected",
            "value": "Rejected",
            "description": "The customer rejected the inbound call."
          },
          {
            "name": "customer_hangup",
            "value": "CustomerHangup",
            "description": "The customer requested hangup."
          },
          {
            "name": "sip_proxy_terminate",
            "value": "SipProxyTerminate",
            "description": "The caller-side SIP leg ended."
          },
          {
            "name": "decision_timeout",
            "value": "DecisionTimeout",
            "description": "The inbound decision timeout expired."
          },
          {
            "name": "setup_failure",
            "value": "SetupFailure",
            "description": "Runtime setup failed before the call connected."
          },
          {
            "name": "transfer_succeeded",
            "value": "TransferSucceeded",
            "description": "A blind transfer completed successfully."
          },
          {
            "name": "runtime_error",
            "value": "RuntimeError",
            "description": "A fatal runtime error ended the call."
          }
        ]
      }
    },
    "SipConfiguration": {
      "type": "object",
      "description": "The customer-facing resource-level SIP configuration. The digest password is never returned.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The configuration identifier. Always `sip_configuration`.",
          "enum": [
            "sip_configuration"
          ],
          "x-ms-enum": {
            "modelAsString": false
          }
        },
        "object": {
          "type": "string",
          "description": "The object type. Always `sip.configuration`.",
          "enum": [
            "sip.configuration"
          ],
          "x-ms-enum": {
            "modelAsString": false
          }
        },
        "password_set": {
          "type": "boolean",
          "description": "Whether a digest password is configured."
        },
        "allowed_source_cidrs": {
          "type": "array",
          "description": "The normalized signaling source allowlist.",
          "items": {
            "type": "string"
          }
        },
        "call_identity": {
          "$ref": "#/definitions/SipCallIdentity",
          "description": "The APIM-authenticated resource identity captured for downstream SIP calls."
        },
        "voice_live_agent_configuration": {
          "type": "object",
          "description": "The stored default Voice Live agent configuration.",
          "additionalProperties": {}
        },
        "created_at": {
          "type": "integer",
          "format": "int64",
          "description": "The configuration creation time, as Unix epoch seconds."
        },
        "updated_at": {
          "type": "integer",
          "format": "int64",
          "description": "The most recent configuration update time, as Unix epoch seconds."
        }
      },
      "required": [
        "id",
        "object",
        "password_set",
        "allowed_source_cidrs",
        "created_at",
        "updated_at"
      ]
    },
    "SipCreateWebhookRequest": {
      "type": "object",
      "description": "The request body for creating a webhook registration.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The human-readable webhook name.",
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The HTTPS endpoint URL that receives webhook deliveries."
        },
        "event_types": {
          "type": "array",
          "description": "The event types to subscribe to. Defaults to `[\"*\"]` (all supported event types).",
