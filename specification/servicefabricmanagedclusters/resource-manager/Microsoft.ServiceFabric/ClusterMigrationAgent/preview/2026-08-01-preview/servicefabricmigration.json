  "definitions": {
    "ClusterMigrationAgent": {
      "type": "object",
      "description": "Describes an agent that migrates a classic Service Fabric cluster to a Service Fabric managed cluster.",
      "properties": {
        "properties": {
          "$ref": "#/definitions/ClusterMigrationAgentProperties",
          "description": "The resource-specific properties for this resource."
        }
