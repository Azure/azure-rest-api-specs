          "description": "The link to the next page of items"
        }
      },
      "required": [
        "value"
      ]
    },
    "ClusterMigrationAgentMode": {
      "type": "string",
      "description": "The direction in which the migration stages are currently executing.",
      "enum": [
        "Forward",
        "RollingBack"
      ],
      "x-ms-enum": {
        "name": "ClusterMigrationAgentMode",
        "modelAsString": true,
        "values": [
          {
            "name": "Forward",
            "value": "Forward",
            "description": "Stages are executing in roll forward order."
          },
          {
            "name": "RollingBack",
            "value": "RollingBack",
            "description": "Stages are executing in rollback order."
          }
        ]
      }
    },
    "ClusterMigrationAgentNodeTypeDescription": {
      "type": "object",
      "description": "Describes a node type that participates in the migration.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the node type. The name cannot be changed, added, or removed after the migration is created.",
          "minLength": 1,
          "maxLength": 1024
        },
        "isPrimary": {
          "type": "boolean",
          "description": "Indicates whether the node type hosts the system services of the cluster. This value cannot be\nchanged after the migration is created."
        },
        "vmInstanceCount": {
          "type": "integer",
          "format": "int32",
          "description": "The number of virtual machine instances to provision for this node type on the target managed cluster.",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "isPrimary",
        "vmInstanceCount"
      ]
    },
    "ClusterMigrationAgentProperties": {
      "type": "object",
      "description": "The properties of a cluster migration agent resource.",
      "properties": {
        "migrationId": {
          "type": "string",
          "description": "The service generated identifier of the migration.",
          "readOnly": true
        },
        "sourceClusterResourceId": {
          "type": "string",
          "format": "arm-id",
          "description": "The resource identifier of the classic Service Fabric cluster to migrate from. The source and the\ntarget cluster must belong to the same subscription. This value cannot be changed after the\nmigration is created.",
          "x-ms-mutability": [
            "read",
            "create"
          ],
          "x-ms-arm-id-details": {
            "allowedResources": [
              {
                "type": "Microsoft.ServiceFabric/clusters"
              }
            ]
          }
        },
        "targetClusterResourceId": {
          "type": "string",
          "format": "arm-id",
          "description": "The resource identifier of the Service Fabric managed cluster to migrate to. The source and the\ntarget cluster must belong to the same subscription. This value cannot be changed after the\nmigration is created.",
          "x-ms-mutability": [
            "read",
            "create"
          ],
          "x-ms-arm-id-details": {
            "allowedResources": [
              {
                "type": "Microsoft.ServiceFabric/managedClusters"
              }
            ]
          }
        },
        "nodeTypes": {
          "type": "array",
          "description": "The node types that are migrated to the target managed cluster. At least one node type is required.\nNode types cannot be added or removed after the migration is created.",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ClusterMigrationAgentNodeTypeDescription"
          },
          "x-ms-identifiers": [
            "name"
          ]
        },
        "retryPolicy": {
          "$ref": "#/definitions/ClusterMigrationAgentRetryPolicy",
          "description": "The policy applied when a migration stage fails."
        },
        "rollbackOnFailure": {
          "type": "boolean",
          "description": "Indicates whether the migration automatically rolls back when a stage fails.",
          "default": false
        },
        "startMode": {
          "type": "string",
          "description": "Controls how the migration is started once provisioning completes.",
          "default": "Auto",
          "enum": [
            "Auto",
            "Manual"
          ],
          "x-ms-enum": {
