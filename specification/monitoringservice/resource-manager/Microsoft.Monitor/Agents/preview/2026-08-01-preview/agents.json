      ]
    },
    "ObservabilityAgentPropertiesUpdate": {
      "type": "object",
      "description": "Updatable properties of an observability agent. Omitted properties are unchanged. Null clears optional configuration; a null autonomousOperationsEnabled leaves its existing value unchanged. The resulting configuration must satisfy the autonomous-operation requirements.",
      "properties": {
        "description": {
          "type": "string",
          "description": "Description of the observability agent. Null clears the description.",
          "x-nullable": true
        },
        "monitoringAccountId": {
          "type": "string",
          "format": "arm-id",
          "description": "Resource ID of the Azure Monitor workspace where this agent stores issues. The workspace must be in the same location as the agent. Required when autonomous operations are enabled. If changed, existing issues remain in the previous workspace; only new issues are written to the new workspace.",
          "x-nullable": true
        },
        "autonomousOperationsEnabled": {
          "type": "boolean",
          "description": "Whether the agent can run operations autonomously. Null leaves the existing value unchanged. Enabling autonomy requires a monitoring account and at least one investigation policy.",
          "x-nullable": true
        },
        "instructions": {
          "type": "string",
          "description": "Instructions that guide the agent's behavior. Null clears the instructions.",
          "maxLength": 8192,
          "x-nullable": true
        },
        "investigation": {
          "$ref": "#/definitions/ObservabilityAgentInvestigationConfiguration",
          "description": "Configuration of agent investigations. Null clears the configuration; supplied members are merged with the existing configuration.",
          "x-nullable": true
        },
        "usageCap": {
          "$ref": "#/definitions/ObservabilityAgentUsageCapConfiguration",
          "description": "Usage cap configuration. Null clears the configuration; supplied members are merged with the existing configuration.",
          "x-nullable": true
        },
        "monitoredResources": {
          "type": "array",
          "description": "Resources monitored by this agent. A supplied array replaces the existing array; null or an empty array clears the list.",
          "maxItems": 10,
          "x-nullable": true,
          "items": {
            "$ref": "#/definitions/ObservabilityAgentMonitoredResource"
          },
          "x-ms-identifiers": [
            "name"
          ]
        }
      }
    },
