    "ObservabilityAgentRuleNameFragment": {
      "type": "string",
      "description": "A nonempty alert-rule name fragment.",
      "minLength": 1,
      "maxLength": 64
    },
    "ObservabilityAgentUsageCapConfiguration": {
      "type": "object",
      "description": "Usage cap configuration for an observability agent.",
      "properties": {
        "amountAAC": {
          "type": "number",
          "format": "double",
