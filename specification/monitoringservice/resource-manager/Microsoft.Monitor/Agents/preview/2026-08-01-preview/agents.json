          },
          "x-ms-identifiers": []
        }
      }
    },
    "ObservabilityAgentInvestigationPolicy": {
      "type": "object",
      "description": "An investigation policy. At least one of minimumSeverity, ruleNameContains, or ruleResourceId must be specified.",
      "properties": {
        "policyName": {
          "type": "string",
          "description": "Name of the policy."
        },
        "description": {
          "type": "string",
          "description": "Description of the policy."
        },
        "minimumSeverity": {
          "type": "string",
          "description": "Minimum alert severity used by this policy, represented as a nonempty string.",
          "minLength": 1,
          "maxLength": 64
        },
        "ruleNameContains": {
          "type": "array",
          "description": "Nonempty alert-rule name fragments used by this policy.",
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/ObservabilityAgentRuleNameFragment"
          }
        },
        "ruleResourceId": {
          "type": "array",
          "description": "ARM resource IDs of alert rules used by this policy. The wire property is named ruleResourceId even though its value is an array.",
          "maxItems": 10,
          "items": {
            "type": "string",
            "format": "arm-id",
            "description": "A type definition that refers the id to an Azure Resource Manager resource."
          }
        },
        "locationFilter": {
          "type": "string",
          "description": "Location filter for the policy. An empty string is allowed, but a nonempty value must not contain only whitespace.",
          "maxLength": 64
        }
      }
    },
    "ObservabilityAgentMonitoredResource": {
      "type": "object",
      "description": "An embedded resource monitored by an observability agent.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Logical name of the monitored resource. Must not contain only whitespace.",
          "minLength": 1,
          "maxLength": 64
        },
        "resourceId": {
          "type": "string",
          "format": "arm-id",
          "description": "ARM resource ID of the monitored resource."
