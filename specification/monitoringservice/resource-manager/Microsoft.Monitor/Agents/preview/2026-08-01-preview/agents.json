    "ObservabilityAgentProperties": {
      "type": "object",
      "description": "Properties for an observability agent resource.",
      "properties": {
        "provisioningState": {
          "$ref": "#/definitions/Azure.ResourceManager.ResourceProvisioningState",
          "description": "The resource provisioning state.",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "description": "Description of the observability agent."
        },
        "monitoringAccountId": {
          "type": "string",
          "format": "arm-id",
          "description": "Resource ID of the Azure Monitor workspace where this agent stores the issues it produces. The workspace must be in the same location as the agent. Required when autonomous operations are enabled."
        },
        "autonomousOperationsEnabled": {
          "type": "boolean",
          "description": "Whether the agent can run operations autonomously. When true, monitoringAccountId and at least one investigation policy must be configured."
        },
        "instructions": {
          "type": "string",
          "description": "Instructions that guide the agent's behavior.",
          "maxLength": 8192
        },
        "investigation": {
          "$ref": "#/definitions/ObservabilityAgentInvestigationConfiguration",
          "description": "Configuration of agent investigations."
        },
        "usageCap": {
          "$ref": "#/definitions/ObservabilityAgentUsageCapConfiguration",
          "description": "Usage cap in Azure Agent Credits."
        },
        "monitoredResources": {
          "type": "array",
          "description": "Resources monitored by this agent. These entries are embedded configuration, not child ARM resources.",
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/ObservabilityAgentMonitoredResource"
          },
          "x-ms-identifiers": [
            "name"
          ]
        }
      },
      "required": [
