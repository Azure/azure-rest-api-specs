          "type": "string",
          "description": "Instructions that guide investigations.",
          "maxLength": 8192,
          "x-nullable": true
        },
        "policies": {
          "type": "array",
          "description": "Policies that select alerts for investigation. At least one policy is required when autonomous operations are enabled. On PATCH, a supplied array replaces the existing array.",
          "maxItems": 10,
          "x-nullable": true,
          "items": {
