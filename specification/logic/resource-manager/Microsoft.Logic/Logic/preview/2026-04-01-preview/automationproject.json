  "definitions": {
    "AutomationProject": {
      "type": "object",
      "description": "The automation project resource. An automation project is a logical grouping that owns and manages\nmultiple ContainerApps of kind 'workflowapp' via the managedBy relationship.\nThe automation project is the single entry point for lifecycle management of its auto apps.",
      "properties": {
        "properties": {
          "$ref": "#/definitions/AutomationProjectProperties",
          "description": "The automation project properties."
        },
