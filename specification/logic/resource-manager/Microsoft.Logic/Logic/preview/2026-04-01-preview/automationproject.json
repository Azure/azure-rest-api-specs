      ]
    },
    "AutomationProjectNetworking": {
      "type": "object",
      "description": "Customer-owned network used by the automation project's backing applications.",
      "properties": {
        "subnetResourceId": {
          "type": "string",
          "format": "arm-id",
          "description": "Fully qualified resource ID of a subnet in the same region and customer tenant as the\nautomation project. The subnet may be in a different subscription in that customer tenant.\nService-owned backing resources may be in a different service tenant and subscription.\nThe subnet must be delegated to Microsoft.App/environments. The caller must have\nMicrosoft.Network/virtualNetworks/subnets/join/action permission on every non-null requested\nsubnet, in addition to Microsoft.Logic/automationProjects/write on the project.\nOn create, a subnet provisions network-connected backing applications; omission or null\nprovisions backing applications without a customer subnet. On PUT or PATCH of an existing\nproject, omission preserves the current subnet, the same subnet leaves networking unchanged,\nand a different non-null subnet requests asynchronous migration to replacement backing\napplications. Explicit null requests asynchronous detach to replacement backing applications\nwithout a customer subnet. Detaching an already detached project leaves networking unchanged.\nDuring provisioning or migration, responses describe the requested configuration, not proof\nof effective connectivity. Responses omit subnetResourceId when no customer subnet is requested.",
          "minLength": 1,
          "x-nullable": true,
          "x-ms-mutability": [
            "read",
            "update",
            "create"
          ],
          "x-ms-arm-id-details": {
            "allowedResources": [
              {
                "type": "Microsoft.Network/virtualNetworks/subnets"
              }
            ]
          }
        }
      }
    },
    "AutomationProjectProperties": {
      "type": "object",
      "description": "The properties of the automation project resource.",
      "properties": {
        "provisioningState": {
          "$ref": "#/definitions/AutomationProjectProvisioningState",
          "description": "Gets the provisioning state of the automation project.",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "description": "A description of the automation project.",
          "maxLength": 1024
        },
        "networking": {
          "$ref": "#/definitions/AutomationProjectNetworking",
          "description": "Customer networking configuration. Omitting networking or subnetResourceId in a PUT or PATCH\npreserves the current subnet. Network changes complete asynchronously through replacement\nbacking applications, not an in-place network update. The operation succeeds only after\nreplacement applications are ready, cutover is complete, and old network resources are released.",
          "x-ms-mutability": [
            "read",
            "update",
            "create"
          ]
        }
      }
    },
    "AutomationProjectProvisioningState": {
      "type": "string",
