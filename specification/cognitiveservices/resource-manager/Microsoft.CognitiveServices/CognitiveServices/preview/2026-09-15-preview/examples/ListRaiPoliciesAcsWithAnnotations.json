{
  "operationId": "RaiPolicies_List",
  "parameters": {
    "accountName": "safety-account",
    "api-version": "2026-09-15-preview",
    "resourceGroupName": "resource-group",
    "subscriptionId": "00000000-0000-0000-0000-000000000000"
  },
  "title": "List ACS policies with optional Azure OpenAI judge annotations",
  "responses": {
    "200": {
      "body": {
        "value": [
          {
            "id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/resource-group/providers/Microsoft.CognitiveServices/accounts/safety-account/raiPolicies/annotated-agent-guard",
            "name": "annotated-agent-guard",
            "type": "Microsoft.CognitiveServices/accounts/raiPolicies",
            "etag": "\"00000000-0000-0000-0000-000000000006\"",
            "properties": {
              "type": "UserManaged",
              "format": "ACS",
              "acs": {
                "agent_control_specification_version": "0.4.0-alpha.1",
                "metadata": {
                  "description": "Illustrative annotation authoring; supported annotators and configuration depend on the evaluation host."
                },
                "policies": {
                  "agent-guard": {
                    "type": "rego",
                    "query": "data.agent_guard.verdict"
                  }
                },
                "annotators": {
                  "risk": {
                    "type": "llm",
                    "provider": "azure_openai",
                    "endpoint": "https://synthetic-judge.openai.azure.com/",
                    "deployment": "judge",
                    "api_version": "2024-10-21",
                    "system_prompt": "Classify the complete subject.",
                    "timeout_ms": 10000
                  }
                },
                "intervention_points": {
                  "agent_startup": {
                    "policy_target": "$snap.agent_init",
                    "policy_target_kind": "agent_init",
                    "policy": {
                      "id": "agent-guard"
                    }
                  },
                  "input": {
                    "policy_target": "$snap.input",
                    "policy_target_kind": "user_input",
                    "policy": {
                      "id": "agent-guard"
                    },
                    "annotations": {
                      "risk": {
                        "from": "$target.content"
                      }
                    }
                  },
                  "pre_model_call": {
                    "policy_target": "$snap.messages",
                    "policy_target_kind": "messages",
                    "policy": {
                      "id": "agent-guard"
                    }
                  },
                  "post_model_call": {
                    "policy_target": "$snap.response",
                    "policy_target_kind": "model_response",
                    "policy": {
                      "id": "agent-guard"
                    }
                  },
                  "pre_tool_call": {
                    "policy_target": "$snap.tool_call.args",
                    "policy_target_kind": "tool_args",
                    "policy": {
                      "id": "agent-guard"
                    }
                  },
                  "post_tool_call": {
                    "policy_target": "$snap.tool_result.value",
                    "policy_target_kind": "tool_result",
                    "policy": {
                      "id": "agent-guard"
                    }
                  },
                  "output": {
                    "policy_target": "$snap.output",
                    "policy_target_kind": "assistant_output",
                    "policy": {
                      "id": "agent-guard"
                    },
                    "annotations": {
                      "risk": {
                        "from": "$target.content"
                      }
                    }
                  },
                  "agent_shutdown": {
                    "policy_target": "$snap.summary",
                    "policy_target_kind": "agent_summary",
                    "policy": {
                      "id": "agent-guard"
                    }
                  }
                }
              },
              "acsRegos": [
                {
                  "regoName": "agent-guard"
                }
              ]
            }
          },
          {
            "id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/resource-group/providers/Microsoft.CognitiveServices/accounts/safety-account/raiPolicies/input-guard",
            "name": "input-guard",
            "type": "Microsoft.CognitiveServices/accounts/raiPolicies",
            "etag": "\"00000000-0000-0000-0000-000000000005\"",
            "properties": {
              "type": "UserManaged",
              "format": "ACS",
              "acs": {
                "agent_control_specification_version": "0.4.0-alpha.1",
                "policies": {
                  "input-guard": {
                    "type": "rego",
                    "query": "data.input_guard.verdict"
                  }
                },
                "intervention_points": {
                  "input": {
                    "policy_target": "$snap.input",
                    "policy_target_kind": "user_input",
                    "policy": {
                      "id": "input-guard"
                    }
                  }
                }
              },
              "acsRegos": [
                {
                  "regoName": "input-guard"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
